{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bismigel/orchestra/schemas/report.schema.json",
  "title": "orchestra worker report",
  "description": "Written by a worker at .orchestra/report.json when it finishes or gets stuck. A claim to be verified by the orchestrator, not proof.",
  "type": "object",
  "required": ["task", "status", "summary", "files_changed", "checks", "open_questions"],
  "properties": {
    "task": { "type": "string" },
    "status": { "enum": ["done", "partial", "blocked"] },
    "summary": { "type": "string" },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "result"],
        "properties": {
          "command": { "type": "string" },
          "result": { "enum": ["pass", "fail"] },
          "notes": { "type": "string" }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "met"],
        "properties": { "item": { "type": "string" }, "met": { "type": "boolean" }, "evidence": { "type": "string" } }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "out_of_scope_needed": { "type": "array", "items": { "type": "string" } }
  }
}
