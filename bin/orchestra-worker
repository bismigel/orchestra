#!/usr/bin/env bash
# orchestra-worker: run one sandboxed worker agent on one task, then check what it did.
#
#   orchestra-worker run <task-id> --spec <file> [--worktree <dir>] [--feedback <file>] [--dry-run] [--allow-stale]
#   orchestra-worker run <task-id> --prompt "<text>" [--worktree <dir>] [--dry-run]
#   orchestra-worker summary <task-id> [--worktree <dir>]
#   orchestra-worker diff <task-id> [--worktree <dir>] [--stat] [--rendered]
#                                             review diff, generated files only in the stat; --rendered: the render command's diff
#   orchestra-worker prove <task-id> [--worktree <dir>] [--manual "what you checked"]
#   orchestra-worker land <task-id> [--pr] [--worktree <dir>] [--message-file <file>]
#                                             --pr (or ORCHESTRA_LAND=pr): push a branch and open a pull request;
#                                             a local-branch ORCHESTRA_BASE is moved in place instead of pushed
#   orchestra-worker status [--json] [--prune] [--worktree <dir>]
#                                             what is running now, and what died silently (--prune clears those)
#   orchestra-worker watch [<task-id>]        live view of running workers: what each one is doing right now
#   orchestra-worker review <task-id> [--json]  one-screen digest of a finished run: questions, paths, proofs, diff
#   orchestra-worker scout <task-id> --spec <file> [--state]
#   orchestra-worker scout <task-id> --prompt "<text>" [--state]
#                                             read-only worker maps a draft spec to the code (where things live)
#   orchestra-worker artifact <task-id> [--local] [--open] [--worktree <dir>] [--out <dir>]
#                                             collect a task's report, diff and proofs as an artifact
#   orchestra-worker clean [--yes] [--include-squashed]
#                                             remove worktrees of landed tasks (lists them without --yes)
#   orchestra-worker history [--json]         every task's runs, cost and outcome, including cleaned-up ones
#   orchestra-worker lessons <task-id>        draft lessons.md lines from a run's spec gaps
#   orchestra-worker decide split|ready <task-id> [--spec <file>]
#   orchestra-worker decide triage <task-id> [--worktree <dir>]
#                                             Jev's advisory second opinion (ORCHESTRA_JEV=shadow|advise): flags, never approves
#   orchestra-worker decide mark <task-id> <kind> <value>   record your own call, to compare with Jev's
#   orchestra-worker decide report [--json]   Jev against your calls
#   orchestra-worker doctor                   check the setup: sandbox, harness, key, model, base, gate
#   orchestra-worker guide [<name>] [--print] path of a guide: orchestrator, planning, ops, security, proofs, …
#
# prove runs the landing gate and the task's `proof:` checks in the worktree (outside the sandbox) and records one
# line per check, bound to a hash of the exact code. land rebases, squashes, proves that code and pushes, with
# Proof: trailers. A worker's report is a claim; a proof is evidence orchestra produced itself (docs/proofs.md).
#
# The orchestrator (a stronger model, or you) decides; the worker implements. See docs/design.md.
# Exit codes: 0 ok · 2 usage/config error · 3 model policy violation · 4 no or invalid report · 5 over budget
# (ORCHESTRA_MAX_COST) · 124 timeout · 130 interrupted ·
# anything else: the harness's own exit code.
set -euo pipefail

# Everything lives in main(), called on the last line: bash then parses the whole file before running it, so
# editing this script while a worker runs cannot corrupt that run (bash otherwise reads scripts lazily).
main() {
  local here; here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
  ORCHESTRA_HERE=$here
  local cmd=${1:-}; shift || true
  case "$cmd" in
    run) cmd_run "$here" "$@" ;;
    summary) cmd_summary "$here" "$@" ;;
    diff) cmd_diff "$here" "$@" ;;
    prove) cmd_prove "$here" "$@" ;;
    land) cmd_land "$here" "$@" ;;
    status|ps) cmd_status "$here" "$@" ;;
    watch) cmd_watch "$here" "$@" ;;
    review) cmd_review "$here" "$@" ;;
    scout) cmd_scout "$here" "$@" ;;
    artifact) cmd_artifact "$here" "$@" ;;
    clean) cmd_clean "$here" "$@" ;;
    history) cmd_history "$here" "$@" ;;
    lessons) cmd_lessons "$here" "$@" ;;
    decide) cmd_decide "$here" "$@" ;;
    doctor) cmd_doctor "$here" "$@" ;;
    guide|docs) cmd_guide "$here" "$@" ;;
    -h|--help|help|"") sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'; return 0 ;;
    *) die "unknown command: $cmd (try: run, status, watch, review, scout, decide, prove, land, clean, history, doctor, guide)" ;;
  esac
}

die() { echo "orchestra-worker: $*" >&2; exit 2; }
log() { echo "orchestra-worker: $*" >&2; }

# Config: built-in defaults < ~/.config/orchestra/config.env < <repo>/.orchestra/config.env < the environment.
load_config() {
  local repo=$1 f
  local -A env_set=()
  local v; for v in $(compgen -e | grep '^ORCHESTRA_' || true); do env_set[$v]=${!v}; done
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}/orchestra/config.env" "$repo/.orchestra/config.env"; do
    # shellcheck disable=SC1090
    [ -f "$f" ] && . "$f"
  done
  for v in "${!env_set[@]}"; do printf -v "$v" '%s' "${env_set[$v]}"; done
  ORCHESTRA_HARNESS=${ORCHESTRA_HARNESS:-pi}
  ORCHESTRA_PROFILE=${ORCHESTRA_PROFILE:-dev}   # dev | ops (prompts/worker-<profile>.md, lint rules)
  ORCHESTRA_MODEL=${ORCHESTRA_MODEL:-}
  ORCHESTRA_ALLOWED_MODELS=${ORCHESTRA_ALLOWED_MODELS:-$ORCHESTRA_MODEL}
  ORCHESTRA_ROUTER_EXT=${ORCHESTRA_ROUTER_EXT:-}            # virtual-model router extension (orchestra/auto)
  ORCHESTRA_THINKING=${ORCHESTRA_THINKING:-low}
  ORCHESTRA_TIMEOUT=${ORCHESTRA_TIMEOUT:-45m}
  ORCHESTRA_KEY_ENV=${ORCHESTRA_KEY_ENV:-}
  ORCHESTRA_KEY_CMD=${ORCHESTRA_KEY_CMD:-}
  ORCHESTRA_SANDBOX=${ORCHESTRA_SANDBOX:-bwrap}
  ORCHESTRA_DEVENV_CMD=${ORCHESTRA_DEVENV_CMD:-}
  ORCHESTRA_WORKTREE_CMD=${ORCHESTRA_WORKTREE_CMD:-}
  ORCHESTRA_STATE_CMD=${ORCHESTRA_STATE_CMD:-}                  # host-side read-only live-state snapshot for scouts
  ORCHESTRA_RENDER_CMD=${ORCHESTRA_RENDER_CMD:-}                # prints the rendered form of a worktree (diff --rendered)
  ORCHESTRA_ARTIFACTS_DIR=${ORCHESTRA_ARTIFACTS_DIR:-}
  ORCHESTRA_ARTIFACT_SERVER_ORIGIN=${ORCHESTRA_ARTIFACT_SERVER_ORIGIN:-}
  ORCHESTRA_ARTIFACT_TOKEN_CMD=${ORCHESTRA_ARTIFACT_TOKEN_CMD:-}
  ORCHESTRA_CHECKS=${ORCHESTRA_CHECKS:-the test and lint commands documented in the repository}
  ORCHESTRA_RW_BINDS=${ORCHESTRA_RW_BINDS:-}
  ORCHESTRA_RO_BINDS=${ORCHESTRA_RO_BINDS:-}
  ORCHESTRA_EGRESS_ALLOW=${ORCHESTRA_EGRESS_ALLOW:-}            # empty: the sandbox shares the host network
  ORCHESTRA_BASE=${ORCHESTRA_BASE:-origin/main}                 # what tasks are reviewed against and land on
  ORCHESTRA_GATE=${ORCHESTRA_GATE:-}                            # the repository's landing gate, one shell command
  ORCHESTRA_TASKS_DIR=${ORCHESTRA_TASKS_DIR:-docs/work/tasks}
  ORCHESTRA_PUSH_CMD=${ORCHESTRA_PUSH_CMD:-"git push origin HEAD:refs/heads/{branch}"}
  ORCHESTRA_JEV=${ORCHESTRA_JEV:-off}                           # off | shadow | advise: Jev classifier second opinion
  ORCHESTRA_JEV_MODEL=${ORCHESTRA_JEV_MODEL:-typesafe/jev}      # Cloudflare Workers AI model id
  ORCHESTRA_JEV_ACCOUNT_ID=${ORCHESTRA_JEV_ACCOUNT_ID:-}        # Cloudflare account id (not a secret)
  ORCHESTRA_JEV_KEY_CMD=${ORCHESTRA_JEV_KEY_CMD:-}              # prints a Workers-AI-only API token; never stored
  ORCHESTRA_JEV_URL=${ORCHESTRA_JEV_URL:-}                      # override the endpoint ({account} is substituted)
  ORCHESTRA_JEV_TIMEOUT=${ORCHESTRA_JEV_TIMEOUT:-20}
  ORCHESTRA_JEV_REDACT=${ORCHESTRA_JEV_REDACT:-}                # extra regex to remove from what Jev sees
  case "$ORCHESTRA_JEV" in off|shadow|advise) ;; *) die "ORCHESTRA_JEV must be off, shadow or advise (got '$ORCHESTRA_JEV')" ;; esac
  ORCHESTRA_GENERATED=${ORCHESTRA_GENERATED:-*_templ.go *.pb.go *_gen.go *.gen.go *.min.js *.min.css go.sum package-lock.json yarn.lock pnpm-lock.yaml Cargo.lock poetry.lock uv.lock}
  [ "${ORCHESTRA_NEEDS_MODEL:-1}" = 0 ] && return 0
  [ -n "$ORCHESTRA_MODEL" ] || die "set ORCHESTRA_MODEL (provider/model, e.g. deepseek/deepseek-flash) in config.env"
}

cmd_run() {
  local here=$1; shift
  local task="" spec="" wt="" feedback="" prompt_spec="" dry=0 allow_stale=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --spec) spec=${2:?}; shift 2 ;;
      --prompt) prompt_spec=${2:?}; shift 2 ;;
      --worktree) wt=${2:?}; shift 2 ;;
      --feedback) feedback=${2:?}; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --allow-stale) allow_stale=1; shift ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$task" ] || die "one task id only"; task=$1; shift ;;
    esac
  done
  [ -n "$task" ] || die "usage: orchestra-worker run <task-id> (--spec <file> | --prompt <text>) [--worktree <dir>] [--feedback <file>] [--allow-stale]"
  [[ $task =~ ^[A-Za-z0-9._-]+$ ]] || die "task id may contain letters, digits, . _ - only"
  if [ -n "$prompt_spec" ]; then
    [ -z "$spec" ] || die "--prompt and --spec are mutually exclusive"
    [ -z "$feedback" ] || die "--prompt and --feedback are mutually exclusive"
  fi

  local repo; repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside a git repository"
  load_config "$repo"
  local harness_file="$here/lib/harness/$ORCHESTRA_HARNESS.sh"
  case "$ORCHESTRA_HARNESS" in */*) harness_file=$(realpath -m "$ORCHESTRA_HARNESS") ;; esac   # a path: custom harness
  [ -f "$harness_file" ] || die "unknown harness '$ORCHESTRA_HARNESS' (lib/harness/*.sh, or a path to a .sh file)"
  # shellcheck disable=SC1090
  . "$harness_file"
  if [ -n "$ORCHESTRA_ROUTER_EXT" ]; then
    [ -f "$ORCHESTRA_ROUTER_EXT" ] || die "ORCHESTRA_ROUTER_EXT not found: $ORCHESTRA_ROUTER_EXT"
    ORCHESTRA_ROUTER_EXT=$(realpath "$ORCHESTRA_ROUTER_EXT")
  else
    model_allowed "$ORCHESTRA_MODEL" || die "ORCHESTRA_MODEL $ORCHESTRA_MODEL is not in ORCHESTRA_ALLOWED_MODELS"
  fi

  # Worktree: one per task, next to the repository unless given.
  local common; common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
  [ -n "$wt" ] || wt="$(dirname "$repo")/$(basename "$repo")-worktrees/$task"
  wt=$(realpath -m "$wt")
  if [ ! -d "$wt" ] && [ "$dry" = 1 ]; then
    # A dry run changes nothing: report what would happen and stop before any worktree, claim or state is created.
    log "dry run: would create the worktree $wt (${ORCHESTRA_WORKTREE_CMD:-git worktree add -b orchestra/$task})"
    log "dry run: task $task, harness $ORCHESTRA_HARNESS, model $ORCHESTRA_MODEL; nothing was changed"
    DRY_RUN=1
    local -a hargv sandbox
    harness_argv hargv "$task" "$wt/.orchestra" "<prompt>"
    build_sandbox sandbox "$wt" "$common/worktrees/$task" "$common" "$wt/.orchestra" ""
    printf '%q ' "${sandbox[@]}" "${hargv[@]}"; echo
    return 0
  fi
  if [ ! -d "$wt" ]; then
    [ -z "$feedback" ] || die "$wt does not exist: nothing to give feedback to"
    if [ -n "$ORCHESTRA_WORKTREE_CMD" ]; then
      (cd "$repo" && bash -c "${ORCHESTRA_WORKTREE_CMD//\{task\}/$task}") >&2
    else
      local start_ref=HEAD
      if git -C "$repo" rev-parse --verify -q "$ORCHESTRA_BASE^{commit}" >/dev/null; then start_ref=$ORCHESTRA_BASE; fi
      git -C "$repo" worktree add -q -b "orchestra/$task" "$wt" "$start_ref"
    fi
    [ -d "$wt" ] || die "worktree command did not create $wt"
  fi
  local gitdir; gitdir=$(git -C "$wt" rev-parse --path-format=absolute --git-dir)

  # The spec is resolved in the worktree if relative, so the worker reads the same file the prompt names.
  if [ -z "$feedback" ] && [ -z "$prompt_spec" ]; then
    [ -n "$spec" ] || die "--spec <file> is required for a first run"
    [ -f "$spec" ] || [ -f "$wt/$spec" ] || die "spec not found: $spec"
    case "$spec" in /*) ;; *) [ -f "$wt/$spec" ] || spec=$(realpath "$spec") ;; esac
    case "$spec" in "$wt"/*) spec=${spec#"$wt"/} ;; esac
  fi

  local state="$wt/.orchestra"
  mkdir -p "$state/sessions" "$state/runs" "$state/home"
  if [ -n "$prompt_spec" ]; then
    # An ad-hoc prompt becomes a minimal spec in the worktree, so a run needs no task-board file.
    local prompt_title
    prompt_title=$(printf '%s\n' "$prompt_spec" | head -n1 | cut -c1-80)
    {
      printf -- '---\nid: %s\ntitle: %s\n---\n\n## Goal\n\n%s\n' "$task" "$prompt_title" "$prompt_spec"
    } > "$state/spec.md"
    spec=".orchestra/spec.md"
  elif [ -z "$feedback" ] && [ ! -f "$wt/$spec" ]; then
    # The worker sees only the worktree: a spec that lives elsewhere (uncommitted, another repo) is copied in.
    cp "$spec" "$state/spec.md"; spec=".orchestra/spec.md"
  fi
  if [ -z "$feedback" ] && [ -z "$prompt_spec" ] && [ "$dry" = 0 ]; then
    jev_auto "$here" "$repo" split "$task" --spec "$wt/$spec"
    jev_auto "$here" "$repo" ready "$task" --spec "$wt/$spec"
  fi
  check_fresh "$wt" "$spec" "$ORCHESTRA_BASE" "$dry" "$allow_stale" "$feedback"
  grep -qxF '.orchestra/*' "$common/info/exclude" 2>/dev/null || printf '%s\n' '.orchestra/*' '!.orchestra/config.env' >> "$common/info/exclude"

  local devenv=""
  if [ -n "$ORCHESTRA_DEVENV_CMD" ]; then
    devenv="$state/devenv.sh"
    if [ ! -s "$devenv" ] || [ "$(find "$devenv" -mmin +1440 2>/dev/null)" ]; then
      (cd "$wt" && bash -c "$ORCHESTRA_DEVENV_CMD") > "$devenv" 2>/dev/null || die "ORCHESTRA_DEVENV_CMD failed"
    fi
  fi

  local prompt
  if [ -n "$feedback" ]; then
    [ -f "$feedback" ] || die "feedback file not found: $feedback"
    prompt="Review feedback from the orchestrator. Address all of it, re-run the checks, and rewrite .orchestra/report.json.

$(cat "$feedback")"
  else
    local tpl="$here/prompts/worker.md"
    [ -f "$here/prompts/worker-$ORCHESTRA_PROFILE.md" ] && tpl="$here/prompts/worker-$ORCHESTRA_PROFILE.md"
    [ -f "$repo/.orchestra/worker.md" ] && tpl="$repo/.orchestra/worker.md"   # a repository's own prompt wins
    PROMPT_TEMPLATE=$tpl
    prompt=$(TASK="$task" SPEC="$spec" CHECKS="$ORCHESTRA_CHECKS" python3 -I -c '
import os,sys
t=open(sys.argv[1]).read()
for k in ("TASK","SPEC","CHECKS"): t=t.replace("{{"+k+"}}", os.environ[k])
print(t)' "$tpl")
  fi

  shopt -s nullglob; local runs=("$state"/runs/run-*.jsonl); shopt -u nullglob
  local n=$(( ${#runs[@]} + 1 )) out="$state/runs/run-$(( ${#runs[@]} + 1 ))"
  rm -f "$state/report.json"

  local -a hargv; harness_argv hargv "$task" "$state" "$prompt"
  egress_plan "$dry"
  local -a sandbox; build_sandbox sandbox "$wt" "$gitdir" "$common" "$state" "$devenv"

  if [ "$dry" = 1 ]; then
    DRY_RUN=1
    log "dry run: task $task, run $n, harness $ORCHESTRA_HARNESS, model $ORCHESTRA_MODEL, profile $ORCHESTRA_PROFILE, prompt ${PROMPT_TEMPLATE:-feedback}, worktree $wt"
    printf '%q ' "${sandbox[@]}" "${hargv[@]:0:${#hargv[@]}-1}" "<prompt: ${#prompt} chars>"; echo
    return 0
  fi

  guard_running "$state" "task $task"
  local key=""
  if [ -n "$ORCHESTRA_KEY_ENV" ]; then
    if [ -n "$ORCHESTRA_KEY_CMD" ]; then key=$(bash -c "$ORCHESTRA_KEY_CMD") || die "ORCHESTRA_KEY_CMD failed"
    else key=${!ORCHESTRA_KEY_ENV:-}; fi
    [ -n "$key" ] || die "no API key: set ORCHESTRA_KEY_CMD or export $ORCHESTRA_KEY_ENV"
  fi

  log "task $task run $n: harness $ORCHESTRA_HARNESS, model $ORCHESTRA_MODEL, profile $ORCHESTRA_PROFILE, thinking $ORCHESTRA_THINKING, timeout $ORCHESTRA_TIMEOUT${ORCHESTRA_MAX_COST:+, max cost \$$ORCHESTRA_MAX_COST}"
  local progress; progress=$(progress_script "$harness_file")
  check_budget_setup "$progress"
  write_run_state "$state" "$task" "$n" "$wt" "$ORCHESTRA_MODEL" "$ORCHESTRA_HARNESS" "$out.jsonl" "$progress"
  # The state file outlives this process on every exit path, so it is removed on all of them: normal, timeout
  # (rc 124) and SIGINT. The path is baked into the trap: the trap runs after this function's locals are out of
  # scope, where "$state" would be unbound (set -u) and would abort the run.
  # shellcheck disable=SC2064  # expanded now on purpose: $state is out of scope when the trap runs
  trap "rm -f $(printf '%q' "$state/run.json"); egress_stop" EXIT
  egress_start "$out.egress.log"
  local rc=0 t0=$SECONDS
  launch_worker "$task" "$out" "$progress" "$ORCHESTRA_TIMEOUT"; rc=$LAUNCH_RC
  unset key
  egress_stop
  local secs=$((SECONDS - t0))

  local used; used=$(harness_models_used "$out.jsonl")
  local m bad=""
  for m in $used; do model_allowed "$m" || bad="$bad $m"; done
  harness_usage "$out.jsonl" > "$out.usage.json" || echo '{}' > "$out.usage.json"

  if [ -n "$bad" ]; then log "MODEL POLICY: model(s) not allowed answered:$bad"; rc=3
  elif ! check_report "$state/report.json" "$task"; then [ "$rc" = 0 ] && rc=4
  fi
  # The outcome outlives the run (run.json does not), so `review` can say how the run ended.
  python3 -I -c 'import json,sys,time; json.dump({"exit":int(sys.argv[2]),"secs":int(sys.argv[3]),"finished_at":time.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime())},open(sys.argv[1],"w"))' \
    "$out.result.json" "$rc" "$secs"
  print_summary "$task" "$state" "$n" "$rc" "$secs"
  git -C "$wt" status --short | grep -v '^?? \.orchestra/' | head -15 >&2 || true
  return "$rc"
}

# check_fresh <worktree> <spec> <base> <dry-run> <allow-stale> [<feedback>]: before a first run, refuse a worktree
# whose spec changed on the base since it was made, or rebase one that has no work yet. A worker reading an old
# spec silently implements the wrong thing (issue #1); a worktree with no work loses nothing when rebased.
check_fresh() {
  local wt=$1 spec=$2 base=$3 dry=$4 allow_stale=$5 feedback=${6:-}
  if [ -n "$feedback" ]; then return 0; fi   # later rounds reuse the worktree on purpose

  # A <remote>/<branch> base is fetched (never on a dry run), so the check sees what is really on the base.
  local remote branch
  if [[ $base == */* ]]; then
    remote=${base%%/*}; branch=${base#*/}
    if git -C "$wt" remote | grep -qxF "$remote"; then
      if [ "$dry" != 1 ] && ! git -C "$wt" fetch -q "$remote" "$branch"; then
        log "freshness: could not fetch $remote; checking against the last fetched $base"
      fi
    fi
  fi

  if ! git -C "$wt" rev-parse --verify -q "$base^{commit}" >/dev/null; then
    log "freshness: not checked ($base not found)"
    return 0
  fi

  local behind; behind=$(git -C "$wt" rev-list --count "HEAD..$base")
  if [ "$behind" = 0 ]; then return 0; fi

  # Work: uncommitted changes outside .orchestra/, or commits that change files. An empty claim commit is not work.
  local work=0 line path
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    path=${line:3}
    path=${path#\"}   # git quotes a path with spaces: ".orchestra/a b" is still .orchestra/
    case "$path" in .orchestra/*) continue ;; esac
    work=1; break
  done < <(git -C "$wt" status --porcelain --untracked-files=all)
  if [ "$work" = 0 ] && ! git -C "$wt" diff --quiet "$base...HEAD"; then work=1; fi

  # Only a repository spec can have changed on the base; an outside spec is copied in as .orchestra/spec.md.
  local spec_changed=0
  if [ "$spec" != ".orchestra/spec.md" ]; then
    if git -C "$wt" cat-file -e "$base:$spec" 2>/dev/null && \
       ! git -C "$wt" show "$base:$spec" | cmp -s - "$wt/$spec"; then
      spec_changed=1
    fi
  fi

  if [ "$allow_stale" = 1 ]; then
    log "freshness: $wt is $behind commits behind $base (--allow-stale)"
    return 0
  fi
  if [ "$work" = 0 ]; then
    if [ "$dry" = 1 ]; then
      log "dry run: freshness would rebase $wt onto $base ($behind commits behind)"
      return 0
    fi
    if ! git -C "$wt" rebase -q "$base"; then
      git -C "$wt" rebase --abort >/dev/null 2>&1 || true
      die "freshness: rebase onto $base failed; fix $wt by hand"
    fi
    log "freshness: worktree had no work and was $behind commits behind $base: rebased"
    return 0
  fi
  if [ "$spec_changed" = 1 ]; then
    local why="$spec changed on $base since this worktree was made ($behind commits behind). The worker would read the old spec. Rebase it (git -C $wt rebase $base) or pass --allow-stale."
    if [ "$dry" = 1 ]; then
      log "dry run: freshness would refuse: $why"
      return 0
    fi
    die "freshness: $why"
  fi
  log "freshness: $wt is $behind commits behind $base; the worker reads the older code"
  return 0
}

# guard_running <state-dir> <what>: refuse to start a second run on a task that is running now. Two runs would share
# one worktree, one session and one report. A state file whose process is gone is stale and is removed.
guard_running() {
  local f="$1/run.json" pid
  [ -f "$f" ] || return 0
  pid=$(python3 -I -c 'import json,sys; print(int(json.load(open(sys.argv[1])).get("pid", 0)))' "$f" 2>/dev/null || echo 0)
  if [ "$pid" -gt 0 ] && kill -0 "$pid" 2>/dev/null; then
    die "$2 is already running (pid $pid): wait for it, or see orchestra-worker status"
  fi
  log "removing stale run state of $2 (pid $pid is gone)"; rm -f "$f"
}

# check_budget_setup <progress-reader>: ORCHESTRA_MAX_COST (USD per run) is enforced by the progress reader, which
# sums the cost of each response; without a reader, or with a malformed cap, refuse rather than run uncapped.
check_budget_setup() {
  local cap=${ORCHESTRA_MAX_COST:-}
  [ -n "$cap" ] || return 0
  [[ $cap =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "ORCHESTRA_MAX_COST must be a number of dollars, like 0.50 (got '$cap')"
  [ -n "$1" ] || die "ORCHESTRA_MAX_COST needs a harness progress reader (lib/harness/<harness>_progress.py)"
}

# launch_worker <label> <out> <progress-reader> <timeout>: run the sandboxed harness (the caller's sandbox, hargv and
# key) with the timeout, live progress and the budget cap. Sets LAUNCH_RC. The worker runs in the background so
# the budget watcher can stop it; Ctrl-C stops it too (a background job ignores SIGINT on its own).
launch_worker() {
  local label=$1 out=$2 progress=$3 limit=$4 follower="" cap=${ORCHESTRA_MAX_COST:-0}
  : > "$out.jsonl"; rm -f "$out.overbudget"
  set +e
  # The key reaches the sandbox through file descriptor 9 as a read-only file, never on a command line or disk.
  # stdin is closed: headless harnesses (pi -p) read piped stdin and would wait forever.
  timeout --kill-after=30s "$limit" "${sandbox[@]}" "${hargv[@]}" \
    9< <(printf '%s' "$key") < /dev/null >> "$out.jsonl" 2> "$out.err" &
  ORCH_TPID=$!
  trap launch_interrupted INT TERM
  # Live progress: one line per tool call on stderr, so a background run's output shows what the worker is doing.
  # It only reads the event log; it never talks to the worker. ORCHESTRA_PROGRESS=0 turns the lines off.
  if [ -n "$progress" ] && { [ "${ORCHESTRA_PROGRESS:-1}" != 0 ] || [ "$cap" != 0 ]; }; then
    local -a fargs=(follow "$out.jsonl" --task "$label" --start "$(date +%s)" --max-cost "$cap" --kill "$ORCH_TPID"
                    --flag "$out.overbudget")
    [ "${ORCHESTRA_PROGRESS:-1}" != 0 ] || fargs+=(--quiet)
    python3 -I "$progress" "${fargs[@]}" >&2 & follower=$!
  fi
  wait "$ORCH_TPID"; LAUNCH_RC=$?
  trap - INT TERM; ORCH_TPID=""
  # It may already have exited by itself (it saw the end event).
  if [ -n "$follower" ]; then kill -TERM "$follower" 2>/dev/null || true; wait "$follower" 2>/dev/null || true; fi
  set -e
  if [ -f "$out.overbudget" ]; then LAUNCH_RC=5; fi
  return 0
}

launch_interrupted() {
  if [ -n "${ORCH_TPID:-}" ]; then kill -TERM "$ORCH_TPID" 2>/dev/null || true; fi
  log "interrupted: the worker was stopped"
  exit 130
}

# progress_script <harness-file>: the harness's optional progress reader (<harness>_progress.py next to the
# adapter). Empty when the harness has none: progress is a convenience, never required.
progress_script() {
  local f="${1%.sh}_progress.py"
  [ -f "$f" ] && echo "$f"
  return 0
}

# write_run_state records what is running, so `status` (and an editor widget) can see it without parsing logs.
# Written by the orchestrator's shell, never by the worker: the sandbox has no write access to this file.
write_run_state() {
  local state=$1 task=$2 n=$3 wt=$4 model=$5 harness=$6 events=${7:-} progress=${8:-} kind=${9:-run}
  python3 -I - "$state/run.json" "$task" "$$" "$n" "$wt" "$model" "$harness" "${ORCHESTRA_PROFILE:-dev}" \
    "$events" "$progress" "$kind" <<'PYSTATE'
import json, sys, time
path, task, pid, n, wt, model, harness, profile, events, progress, kind = sys.argv[1:]
json.dump({"task": task, "pid": int(pid), "run": int(n), "worktree": wt, "model": model,
           "harness": harness, "profile": profile, "kind": kind, "events": events, "progress": progress,
           "started": int(time.time()), "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())},
          open(path, "w"), indent=1)
PYSTATE
}

# cmd_status reports every run state file it can find and whether that run is still alive. The pid check is the
# point: a killed or crashed run leaves the file behind, and reporting it as "running" is how an orchestrator waits
# forever on nothing.
cmd_status() {
  local here=$1; shift; local wt="" json=0 prune=0
  while [ $# -gt 0 ]; do case "$1" in
    --json) json=1; shift ;;
    --prune) prune=1; shift ;;
    --worktree) wt=${2:?}; shift 2 ;;
    -*) die "unknown option $1" ;;
    *) die "status takes no positional arguments" ;;
  esac; done

  local repo; repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside a git repository"
  ORCHESTRA_NEEDS_MODEL=0 load_config "$repo"

  local -a files=()
  if [ -n "$wt" ]; then
    [ -f "$wt/.orchestra/run.json" ] && files+=("$wt/.orchestra/run.json")
  else
    local base; base="$(dirname "$repo")/$(basename "$repo")-worktrees"
    shopt -s nullglob; files=("$base"/*/.orchestra/run.json); shopt -u nullglob
  fi

  if [ "$prune" = 1 ]; then json=0; fi   # --prune acts, it does not print JSON
  python3 -I - "$json" "$prune" "${files[@]}" <<'PYSTATUS'
import json, os, subprocess, sys, time
as_json = sys.argv[1] == "1"
prune = sys.argv[2] == "1"
now = int(time.time())
rows = []
for f in sys.argv[3:]:
    try:
        st = json.load(open(f))
    except (OSError, ValueError):
        continue
    pid = int(st.get("pid", 0))
    alive = False
    if pid > 0:
        try:
            os.kill(pid, 0)
            alive = True
        except OSError:
            alive = False
    rows.append({
        "task": st.get("task", "?"),
        "state": "running" if alive else "stale",
        "elapsed_seconds": max(0, now - int(st.get("started", now))),
        "run": st.get("run"),
        "model": st.get("model", ""),
        "harness": st.get("harness", ""),
        "profile": st.get("profile", ""),
        "worktree": st.get("worktree") or f.rsplit("/.orchestra/", 1)[0],
        "started_at": st.get("started_at", ""),
        "pid": pid,
        "kind": st.get("kind", "run"),
        "_file": f,
    })
    # Live progress from the harness's reader, when it has one: tool calls, cost so far, the last action.
    prog, ev = st.get("progress") or "", st.get("events") or ""
    snap = {}
    if alive and prog and ev and os.path.isfile(prog) and os.path.isfile(ev):
        try:
            out = subprocess.run([sys.executable, "-I", prog, "snapshot", ev], capture_output=True, text=True, timeout=5)
            snap = json.loads(out.stdout) if out.returncode == 0 else {}
        except (OSError, ValueError, subprocess.SubprocessError):
            snap = {}
    rows[-1].update({
        "tool_calls": snap.get("tool_calls"),
        "cost": snap.get("cost"),
        "last_action": snap.get("last_action", ""),
        "quiet_seconds": max(0, now - int(snap["last_activity"])) if snap.get("last_activity") else None,
        "files_touched": snap.get("files_touched", []),
    })
rows.sort(key=lambda r: (r["state"] != "running", r["task"]))

for r in rows:
    r["state_file"] = r.pop("_file")

if prune:
    removed = 0
    for r in rows:
        if r["state"] == "stale":
            try:
                os.remove(r["state_file"])
                removed += 1
            except OSError:
                pass
    sys.stderr.write("pruned %d stale run state file(s)\n" % removed)
    raise SystemExit(0)


if as_json:
    print(json.dumps({"runs": rows, "running": sum(1 for r in rows if r["state"] == "running")}, indent=1))
    raise SystemExit(0)

if not rows:
    print("no runs")
    raise SystemExit(0)

def dur(s):
    s = int(s); m, s = divmod(s, 60); h, m = divmod(m, 60)
    if h: return "%dh%02dm" % (h, m)
    if m: return "%dm%02ds" % (m, s)
    return "%ds" % s

print("%-8s %-8s %-8s %-4s %5s %7s  %s" % ("TASK", "STATE", "ELAPSED", "RUN", "TOOLS", "COST", "NOW"))
for r in rows:
    task = r["task"] + (" (scout)" if r.get("kind") == "scout" else "")
    cost = "$%.3f" % r["cost"] if r.get("cost") is not None else "-"
    tools = str(r["tool_calls"]) if r.get("tool_calls") is not None else "-"
    now_s = r.get("last_action") or ""
    q = r.get("quiet_seconds")
    if r["state"] == "running" and q is not None and q >= 120:
        now_s = "quiet %s · %s" % (dur(q), now_s)   # no event for a while: thinking, a long command, or stuck
    if r["state"] == "stale":
        now_s = "process gone"
    print("%-8s %-8s %-8s %-4s %5s %7s  %s" % (task, r["state"], dur(r["elapsed_seconds"]), r["run"] or "",
          tools, cost, now_s[:70]))
stale = [r for r in rows if r["state"] == "stale"]
if stale:
    sys.stderr.write("\n%d stale: the process is gone but its state file was not cleaned up.\n"
                     "Re-run the task, or delete %s/.orchestra/run.json\n"
                     % (len(stale), stale[0]["worktree"]))
PYSTATUS
}

model_allowed() {
  local m=$1 a
  IFS=', ' read -r -a allowed <<< "$ORCHESTRA_ALLOWED_MODELS"
  for a in "${allowed[@]}"; do [ "$a" = "$m" ] && return 0; done
  return 1
}

# Sandbox (Linux, bubblewrap): the worker sees its worktree read-write, the repo's git objects read-only, system
# directories read-only and a scratch home. Nothing else from your home: no keys, no cloud config, no ssh.
build_sandbox() {
  local -n _sb=$1; local wt=$2 gitdir=$3 common=$4 state=$5 devenv=$6
  case "$ORCHESTRA_SANDBOX" in
    none)
      [ "${ORCHESTRA_ALLOW_UNSANDBOXED:-}" = 1 ] || die "ORCHESTRA_SANDBOX=none needs ORCHESTRA_ALLOW_UNSANDBOXED=1"
      [ "${SCOUT:-}" = 1 ] && log "warning: ORCHESTRA_SANDBOX=none: the scout is NOT read-only without a sandbox"
      _sb=(env -C "$wt" HOME="$state/home" bash -c "$INNER" "$ORCHESTRA_KEY_ENV" "${devenv:-}")
      return ;;
    bwrap) command -v bwrap >/dev/null || die "bubblewrap (bwrap) not found; install it or see docs/security.md" ;;
    *) die "unknown ORCHESTRA_SANDBOX '$ORCHESTRA_SANDBOX' (bwrap, none)" ;;
  esac
  local home=/home/worker
  # Network: shared with the host by default. With ORCHESTRA_EGRESS_ALLOW, a private network namespace (loopback
  # only) whose one way out is the egress proxy's socket, bound in below.
  local -a net=(--share-net); [ -n "${EGRESS_SOCK:-}" ] && net=()
  _sb=(bwrap --die-with-parent --new-session --unshare-all "${net[@]}"
       --proc /proc --dev /dev --tmpfs /tmp --tmpfs /run)
  local p
  for p in /usr /bin /sbin /lib /lib64 /lib32 /etc /nix /opt /run/current-system; do
    [ -e "$p" ] && _sb+=(--ro-bind "$p" "$p")
  done
  if [ "${SCOUT:-}" = 1 ]; then
    # Scout: the checkout and all of git read-only; writable are only its home and its own state directory.
    _sb+=(--ro-bind "$wt" "$wt" --ro-bind "$common" "$common" --bind "$state" "$state" --bind "$state/home" "$home")
  else
    _sb+=(--bind "$state/home" "$home" --bind "$wt" "$wt" --ro-bind "$common" "$common" --bind "$gitdir" "$gitdir")
  fi
  local pair src dst ro_binds="$ORCHESTRA_RO_BINDS"
  # The router extension is a file, not a bind directory; mount it at the same absolute path the pi argv names.
  [ -n "${ORCHESTRA_ROUTER_EXT:-}" ] && ro_binds="$ro_binds $ORCHESTRA_ROUTER_EXT:$ORCHESTRA_ROUTER_EXT"
  for pair in $ro_binds; do src=${pair%%:*}; dst=${pair#*:}; src=${src/#\~/$HOME}; dst=${dst/#\~/$home}
    [ -e "$src" ] || [ "${DRY_RUN:-}" = 1 ] || mkdir -p "$src"; _sb+=(--ro-bind "$src" "$dst"); done
  for pair in $ORCHESTRA_RW_BINDS; do src=${pair%%:*}; dst=${pair#*:}; src=${src/#\~/$HOME}; dst=${dst/#\~/$home}
    [ "${DRY_RUN:-}" = 1 ] || mkdir -p "$src"; _sb+=(--bind "$src" "$dst"); done
  if [ -n "${EGRESS_SOCK:-}" ]; then
    _sb+=(--bind "$EGRESS_SOCK" /run/orchestra-egress.sock
          --ro-bind "$ORCHESTRA_HERE/lib/egress_forward.py" /run/orchestra-egress-forward.py)
  fi
  _sb+=(--clearenv --setenv HOME "$home" --setenv USER worker --setenv LANG C.UTF-8 --setenv TERM dumb
        --setenv PATH "$(sandbox_path)")
  [ -n "${EGRESS_SOCK:-}" ] && _sb+=(--setenv ORCHESTRA_EGRESS_PORT 3128)
  _sb+=(--chdir "$wt" /usr/bin/env bash -c "$INNER" "$ORCHESTRA_KEY_ENV" "${devenv:-}")
}

# ---- egress allowlist (ORCHESTRA_EGRESS_ALLOW; docs/security.md) ----------------------------------------------------
# egress_plan <dry>: choose the proxy socket path before the sandbox is built. A short /tmp path: unix sockets are
# limited to about 108 bytes, and worktree paths can be long.
egress_plan() {
  EGRESS_SOCK=""; EGRESS_PID=""; EGRESS_DIR=""
  [ -n "$ORCHESTRA_EGRESS_ALLOW" ] || return 0
  [ "$ORCHESTRA_SANDBOX" = bwrap ] || die "ORCHESTRA_EGRESS_ALLOW needs ORCHESTRA_SANDBOX=bwrap (without a sandbox nothing can be enforced)"
  python3 -I "$ORCHESTRA_HERE/lib/egress_proxy.py" --check --allow "$ORCHESTRA_EGRESS_ALLOW" || exit 2
  if [ "${1:-0}" = 1 ]; then EGRESS_SOCK=/tmp/orchestra-egress.DRYRUN/s; return 0; fi
  EGRESS_DIR=$(mktemp -d /tmp/orchestra-egress.XXXXXX); EGRESS_SOCK="$EGRESS_DIR/s"
}

# egress_start <log>: start the proxy outside the sandbox and wait for its socket. Fails the run if it cannot start:
# a run that was asked to be confined never runs unconfined.
egress_start() {
  [ -n "${EGRESS_SOCK:-}" ] || return 0
  python3 -I "$ORCHESTRA_HERE/lib/egress_proxy.py" --socket "$EGRESS_SOCK" --allow "$ORCHESTRA_EGRESS_ALLOW" --log "$1" \
    </dev/null 2>"$EGRESS_DIR/err" & EGRESS_PID=$!
  local i=0
  while [ ! -S "$EGRESS_SOCK" ]; do
    kill -0 "$EGRESS_PID" 2>/dev/null || die "egress proxy failed: $(cat "$EGRESS_DIR/err" 2>/dev/null)"
    i=$((i+1)); [ "$i" -le 50 ] || die "egress proxy did not start"
    sleep 0.1
  done
  log "egress: only $ORCHESTRA_EGRESS_ALLOW (log: $1)"
}

egress_stop() {
  if [ -n "${EGRESS_PID:-}" ]; then kill "$EGRESS_PID" 2>/dev/null || true; wait "$EGRESS_PID" 2>/dev/null || true; EGRESS_PID=""; fi
  if [ -n "${EGRESS_DIR:-}" ]; then rm -rf "$EGRESS_DIR"; EGRESS_DIR=""; fi
  return 0
}

# The worker's PATH: your PATH with symlinks resolved, keeping only directories mounted in the sandbox (so the same
# python3, git, node, … you use are there), plus the usual system directories.
sandbox_path() {
  local out="" d r
  local IFS=:
  for d in $PATH /usr/local/bin /usr/bin /bin; do
    r=$(readlink -f "$d" 2>/dev/null) || continue
    [ -d "$r" ] || continue
    case "$r" in /usr/*|/bin|/bin/*|/sbin/*|/nix/*|/opt/*|/run/current-system/*|/etc/*) ;; *) continue ;; esac
    case ":$out:" in *":$r:"*) ;; *) out=${out:+$out:}$r ;; esac
  done
  printf '%s' "$out"
}

# Runs first inside the sandbox: take the key from fd 9 into the named variable, close fd 9 so the harness never
# inherits it, source the dev environment if there is one, then become the harness. $0 = key variable, $1 = devenv.
INNER='k=$(cat <&9 2>/dev/null); exec 9<&-
if [ -n "$0" ] && [ -n "$k" ]; then export "$0=$k"; fi; unset k
if [ -n "$1" ]; then . "$1" >/dev/null 2>&1; fi
if [ -n "${ORCHESTRA_EGRESS_PORT:-}" ]; then
  python3 -I /run/orchestra-egress-forward.py /run/orchestra-egress.sock "$ORCHESTRA_EGRESS_PORT" &
  i=0; until python3 -I -c "import socket,sys; socket.create_connection((\"127.0.0.1\", int(sys.argv[1])), 1)" "$ORCHESTRA_EGRESS_PORT" 2>/dev/null; do
    i=$((i+1)); if [ "$i" -gt 50 ]; then echo "orchestra: the egress forwarder did not start" >&2; exit 125; fi; sleep 0.1
  done
  p=http://127.0.0.1:$ORCHESTRA_EGRESS_PORT; n=localhost,127.0.0.1,::1
  export HTTPS_PROXY=$p HTTP_PROXY=$p https_proxy=$p http_proxy=$p ALL_PROXY=$p NO_PROXY=$n no_proxy=$n NODE_USE_ENV_PROXY=1
fi
shift; exec "$@"'


check_report() {
  local f=$1 task=$2
  [ -s "$f" ] || { log "no report written ($f)"; return 1; }
  python3 -I - "$f" "$task" <<'PY' || return 1
import json, sys
try:
    r = json.load(open(sys.argv[1]))
except Exception as e:
    sys.exit(f"orchestra-worker: report is not valid JSON: {e}")
need = {"task": str, "status": str, "summary": str, "files_changed": list, "checks": list, "open_questions": list}
bad = [k for k, t in need.items() if not isinstance(r.get(k), t)]
if bad: sys.exit(f"orchestra-worker: report missing or wrong type: {', '.join(bad)}")
if r["status"] not in ("done", "partial", "blocked"): sys.exit("orchestra-worker: report status must be done, partial or blocked")
for k in ("assumptions", "out_of_scope_needed"):
    if k in r and not isinstance(r[k], list): sys.exit(f"orchestra-worker: report field {k} must be a list")
if r["task"] != sys.argv[2]: sys.exit(f"orchestra-worker: report is for task {r['task']}, not {sys.argv[2]}")
PY
}

# print_summary <task> <state> <run> <exit|-> [secs]: the card printed when a run ends (and by `summary`).
# Blocking questions come first: they are what the orchestrator has to act on.
print_summary() {
  local task=$1 state=$2 n=$3 rc=$4 secs=${5:-}
  python3 -I - "$task" "$state" "$n" "$rc" "$secs" <<'PY' >&2
import json, sys, glob
task, state, n, rc, secs = sys.argv[1:]
def load(p):
    try: return json.load(open(p))
    except Exception: return {}
run = load(f"{state}/runs/run-{n}.usage.json")
total = 0.0
for p in glob.glob(f"{state}/runs/run-*.usage.json"): total += load(p).get("cost", 0) or 0
rep = load(f"{state}/report.json")
meaning = {"0": "ok", "3": "DISALLOWED MODEL: discard the run", "4": "NO VALID REPORT", "124": "TIMED OUT",
           "5": "OVER BUDGET: stopped at ORCHESTRA_MAX_COST", "130": "INTERRUPTED",
           "-": ""}.get(rc, "harness failed: read the run's .err file")
took = ""
if secs:
    m, s_ = divmod(int(secs), 60); took = f" · {m}m{s_:02d}s" if m else f" · {s_}s"
print(f"── {task} · run {n} exit {rc}{' (' + meaning + ')' if meaning else ''}{took}"
      f" · {run.get('responses', 0)} responses · ${run.get('cost', 0):.4f} (task total: ${total:.4f})")
if rep:
    blocking = rep.get("open_questions") or []
    assumed = rep.get("assumptions") or []
    print(f"   status    {rep.get('status')}: {rep.get('summary')}")
    print(f"   counts    {len(rep.get('files_changed') or [])} files · {len(blocking)} blocking · {len(assumed)} assumed"
          f" · {len(rep.get('out_of_scope_needed') or [])} outside scope")
    for q in blocking: print(f"   BLOCKING  {q}")
    for q in assumed: print(f"   assumed   {q}")
eg = f"{state}/runs/run-{n}.egress.log"
try:
    rows = [l.split() for l in open(eg) if l.strip()]
except OSError:
    rows = None
if rows is not None:
    allow = sum(1 for r in rows if len(r) > 1 and r[1] == "allow")
    denied = sorted({r[2] for r in rows if len(r) > 2 and r[1] == "deny"})
    print(f"   egress    {allow} allowed · {len(denied)} host(s) denied" + (f": {', '.join(denied[:5])}" if denied else ""))
print(f"   next      orchestra-worker review {task}")
PY
}

cmd_summary() {
  local here=$1; shift
  local task=${1:-} wt=""; shift || true
  [ "${1:-}" = --worktree ] && wt=${2:-}
  [ -n "$task" ] || die "usage: orchestra-worker summary <task-id> [--worktree <dir>]"
  local repo; repo=$(git rev-parse --show-toplevel)
  [ -n "$wt" ] || wt="$(dirname "$repo")/$(basename "$repo")-worktrees/$task"
  shopt -s nullglob; local runs=("$wt"/.orchestra/runs/run-*.jsonl); shopt -u nullglob
  [ ${#runs[@]} -gt 0 ] || die "no runs for $task in $wt"
  print_summary "$task" "$wt/.orchestra" "${#runs[@]}" "-"
}

# ---- watching, reviewing, cleaning, scouting ---------------------------------------------------------------------

# cmd_watch: the status table plus each running worker's last few actions, redrawn every 2s until nothing runs.
# Read-only, like status. Ctrl-C leaves the view; the workers keep running.
cmd_watch() {
  local here=$1; shift; local only=${1:-} interval=${ORCHESTRA_WATCH_INTERVAL:-2}
  local repo; repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside a git repository"
  local base; base="$(dirname "$repo")/$(basename "$repo")-worktrees"
  local tty=0; [ -t 1 ] && tty=1
  while :; do
    local -a files=(); shopt -s nullglob
    if [ -n "$only" ]; then files=("$base/$only/.orchestra/run.json" "$base/.scout/$only/run.json")
    else files=("$base"/*/.orchestra/run.json "$base"/.scout/*/run.json); fi
    shopt -u nullglob
    local frame; frame=$(
      echo "orchestra · $(date +%H:%M:%S) · Ctrl-C stops watching (workers keep running)"; echo
      cmd_status "$here" 2>/dev/null
      local f; for f in "${files[@]}"; do [ -f "$f" ] || continue
        python3 -I "$here/lib/watch_tail.py" "$f" 6
      done)
    if [ "$tty" = 1 ]; then printf '\033[H\033[2J%s\n' "$frame"; else printf '%s\n\n' "$frame"; fi
    grep -q ' running ' <<<"$frame" || { echo "no worker running"; return 0; }
    sleep "$interval"
  done
}

# cmd_review: everything the orchestrator reads first, on one screen (lib/review.py). No model, read-only.
cmd_review() {
  local here=$1; shift; local task="" wt="" json=0
  while [ $# -gt 0 ]; do case "$1" in
    --worktree) wt=${2:?}; shift 2 ;;
    --json) json=1; shift ;;
    -*) die "unknown option $1" ;;
    *) task=$1; shift ;;
  esac; done
  [ -n "$task" ] || die "usage: orchestra-worker review <task-id> [--json] [--worktree <dir>]"
  local repo state; task_setup "$task" "$wt"
  local -a extra=(); [ "$json" = 1 ] && extra=(--json)
  local rc=0
  python3 -I "$here/lib/review.py" --task "$task" --worktree "$wt" --base "$ORCHESTRA_BASE" \
    --spec "$(spec_file "$wt" "$task")" --generated "$ORCHESTRA_GENERATED" --checks "$(checks "$wt" "$task")" \
    --tree "$(work_tree "$wt")" "${extra[@]}" || rc=$?
  # Jev's second opinion goes after the digest, and only on the text screen: --json stays one parseable object.
  [ "$rc" = 0 ] && [ "$json" = 0 ] && jev_triage_auto "$here" "$repo" "$task" "$wt"
  return "$rc"
}

# ---- Jev: an advisory second opinion (lib/decide.py, config/decisions.json, docs/jev.md) ---------------------------
# ORCHESTRA_JEV=off makes no call at all. shadow logs Jev's answer; advise also prints a line when Jev wants a closer
# look than you or the review facts already give. Jev never approves anything and a failure never changes an exit code.
decisions_log() { echo "$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)/orchestra/decisions.jsonl"; }

# jev_run <here> <repo> <print: always|flags|never> <mode> <kind> <task> [decide.py args]: one call, never fails the caller.
jev_run() {
  local here=$1 repo=$2 pr=$3 mode=$4 kind=$5 task=$6; shift 6
  local decisions="$here/config/decisions.json"
  [ -f "$repo/.orchestra/decisions.json" ] && decisions="$repo/.orchestra/decisions.json"   # a repository's own questions win
  env ORCHESTRA_JEV_MODEL="$ORCHESTRA_JEV_MODEL" ORCHESTRA_JEV_ACCOUNT_ID="$ORCHESTRA_JEV_ACCOUNT_ID" \
    ORCHESTRA_JEV_KEY_CMD="$ORCHESTRA_JEV_KEY_CMD" ORCHESTRA_JEV_URL="$ORCHESTRA_JEV_URL" \
    ORCHESTRA_JEV_TIMEOUT="$ORCHESTRA_JEV_TIMEOUT" ORCHESTRA_JEV_REDACT="$ORCHESTRA_JEV_REDACT" \
    python3 -I "$here/lib/decide.py" run --kind "$kind" --task "$task" --log "$(decisions_log "$repo")" \
    --decisions "$decisions" --print "$pr" --mode "$mode" "$@" || true
}

# jev_auto <here> <repo> <kind> <task> [decide.py args]: the hook the other commands call; a no-op when off.
jev_auto() {
  local here=$1 repo=$2 kind=$3 task=$4; shift 4
  case "$ORCHESTRA_JEV" in
    shadow) jev_run "$here" "$repo" never shadow "$kind" "$task" "$@" ;;
    advise) jev_run "$here" "$repo" flags advise "$kind" "$task" "$@" ;;
    *) return 0 ;;
  esac
}

# review_json <here> <task> <wt> <out>: the review digest as JSON in a file (what triage reads).
review_json() {
  local here=$1 task=$2 wt=$3 out=$4
  python3 -I "$here/lib/review.py" --task "$task" --worktree "$wt" --base "$ORCHESTRA_BASE" \
    --spec "$(spec_file "$wt" "$task")" --generated "$ORCHESTRA_GENERATED" --checks "$(checks "$wt" "$task")" \
    --tree "$(work_tree "$wt")" --json > "$out"
}

jev_triage_auto() {
  local here=$1 repo=$2 task=$3 wt=$4 tmp
  [ "$ORCHESTRA_JEV" = off ] && return 0
  tmp=$(mktemp); review_json "$here" "$task" "$wt" "$tmp" 2>/dev/null && jev_auto "$here" "$repo" triage "$task" --review-json "$tmp"
  rm -f "$tmp"; return 0
}

# cmd_decide: ask Jev by hand, record your own call, or compare the two.
cmd_decide() {
  local here=$1; shift
  local sub=${1:-}; shift || true
  local repo; repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside a git repository"
  ORCHESTRA_NEEDS_MODEL=0 load_config "$repo"
  local log; log=$(decisions_log "$repo")
  case "$sub" in
    report)
      local -a extra=(); [ "${1:-}" = --json ] && extra=(--json)
      python3 -I "$here/lib/decide.py" report --log "$log" "${extra[@]}" ;;
    mark)
      [ $# -eq 3 ] || die "usage: orchestra-worker decide mark <task-id> <kind> <value>"
      [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || die "task id may contain letters, digits, . _ - only"
      python3 -I "$here/lib/decide.py" mark --log "$log" --task "$1" --kind "$2" --value "$3" ;;
    split|ready|triage)
      local kind=$sub task="" spec="" wt=""
      while [ $# -gt 0 ]; do case "$1" in
        --spec) spec=${2:?}; shift 2 ;;
        --worktree) wt=${2:?}; shift 2 ;;
        -*) die "unknown option $1" ;;
        *) task=$1; shift ;;
      esac; done
      [ -n "$task" ] || die "usage: orchestra-worker decide $kind <task-id>$([ "$kind" = triage ] && echo ' [--worktree <dir>]' || echo ' [--spec <file>]')"
      [ "$ORCHESTRA_JEV" != off ] || die "ORCHESTRA_JEV=off: set it to shadow or advise (and ORCHESTRA_JEV_ACCOUNT_ID, ORCHESTRA_JEV_KEY_CMD) to ask Jev; docs/jev.md"
      if [ "$kind" = triage ]; then
        local state; task_setup "$task" "$wt"
        local tmp; tmp=$(mktemp); review_json "$here" "$task" "$wt" "$tmp" || { rm -f "$tmp"; die "review failed for $task"; }
        jev_run "$here" "$repo" always "$ORCHESTRA_JEV" triage "$task" --review-json "$tmp"; rm -f "$tmp"
      else
        if [ -z "$spec" ]; then local state; task_setup "$task" "$wt"; spec=$(spec_file "$wt" "$task"); fi
        [ -f "$spec" ] || die "no spec found for $task: pass --spec <file>"
        jev_run "$here" "$repo" always "$ORCHESTRA_JEV" "$kind" "$task" --spec "$spec"
      fi ;;
    *) die "usage: orchestra-worker decide split|ready <task-id> [--spec <file>] | triage <task-id> | mark <task-id> <kind> <value> | report [--json]" ;;
  esac
}

# ledger_file <repo>: where cleaned-up tasks are archived (one JSON line each). Inside the git common dir: never
# committed, shared by every worktree, and it survives `clean`.
ledger_file() { echo "$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)/orchestra/ledger.jsonl"; }

# cmd_history: every task's runs, cost and outcome: live worktrees plus the ledger of cleaned-up ones.
cmd_history() {
  local here=$1; shift
  local repo; repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside a git repository"
  python3 -I "$here/lib/history.py" --worktrees "$(dirname "$repo")/$(basename "$repo")-worktrees" \
    --ledger "$(ledger_file "$repo")" "$@"
}

# cmd_lessons: draft lines for the lessons file from what a run's review shows the spec missed.
cmd_lessons() {
  local here=$1; shift; local task="" wt=""
  while [ $# -gt 0 ]; do case "$1" in --worktree) wt=${2:?}; shift 2 ;; -*) die "unknown option $1" ;; *) task=$1; shift ;; esac; done
  [ -n "$task" ] || die "usage: orchestra-worker lessons <task-id> [--worktree <dir>]"
  local repo state; task_setup "$task" "$wt"
  python3 -I "$here/lib/review.py" --task "$task" --worktree "$wt" --base "$ORCHESTRA_BASE" \
    --spec "$(spec_file "$wt" "$task")" --generated "$ORCHESTRA_GENERATED" --checks "$(checks "$wt" "$task")" \
    --tree "$(work_tree "$wt")" --json | python3 -I "$here/lib/lessons.py" --task "$task"
}

# cmd_doctor: check everything a run depends on, before a run finds out. Never prints the API key: only its length
# and a short fingerprint. Exit 1 when anything FAILs; warnings do not fail.
cmd_doctor() {
  local here=$1; shift
  local repo; repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside a git repository"
  ORCHESTRA_NEEDS_MODEL=0 load_config "$repo"
  local nfail=0 nwarn=0
  ok_()   { echo "ok    $*"; }
  warn_() { echo "warn  $*"; nwarn=$((nwarn+1)); }
  fail_() { echo "FAIL  $*"; nfail=$((nfail+1)); }
  local g="${XDG_CONFIG_HOME:-$HOME/.config}/orchestra/config.env" f
  for f in "$g" "$repo/.orchestra/config.env"; do
    if [ -f "$f" ]; then ok_ "config: $f"; else echo "info  config: $f (not present)"; fi
  done
  # Model
  if [ -z "$ORCHESTRA_MODEL" ]; then fail_ "ORCHESTRA_MODEL is not set"
  elif [ -n "$ORCHESTRA_ROUTER_EXT" ]; then ok_ "model $ORCHESTRA_MODEL (virtual model; physical models checked post-run against ORCHESTRA_ALLOWED_MODELS)"
  elif model_allowed "$ORCHESTRA_MODEL"; then ok_ "model $ORCHESTRA_MODEL (allowed: $ORCHESTRA_ALLOWED_MODELS)"
  else fail_ "model $ORCHESTRA_MODEL is not in ORCHESTRA_ALLOWED_MODELS ($ORCHESTRA_ALLOWED_MODELS)"; fi
  if [ -n "$ORCHESTRA_ROUTER_EXT" ]; then
    if [ -f "$ORCHESTRA_ROUTER_EXT" ]; then
      ok_ "router extension: $ORCHESTRA_ROUTER_EXT (physical models checked post-run against ORCHESTRA_ALLOWED_MODELS)"
    else fail_ "router extension: $ORCHESTRA_ROUTER_EXT not found"; fi
  fi
  # Harness
  local hf="$here/lib/harness/$ORCHESTRA_HARNESS.sh"
  case "$ORCHESTRA_HARNESS" in */*) hf=$(realpath -m "$ORCHESTRA_HARNESS") ;; esac
  if [ -f "$hf" ]; then
    ok_ "harness $ORCHESTRA_HARNESS ($hf)"
    if [ "$ORCHESTRA_HARNESS" = pi ]; then
      if command -v pi >/dev/null; then ok_ "pi $(pi --version 2>/dev/null | head -1) at $(command -v pi)"; else fail_ "pi is not on PATH"; fi
    fi
    if [ -n "$(progress_script "$hf")" ]; then ok_ "progress reader: live progress and ORCHESTRA_MAX_COST available"
    else warn_ "no progress reader for this harness: no live progress, ORCHESTRA_MAX_COST cannot be used"; fi
  else fail_ "harness '$ORCHESTRA_HARNESS' not found ($hf)"; fi
  # Sandbox
  case "$ORCHESTRA_SANDBOX" in
    bwrap)
      if ! command -v bwrap >/dev/null; then fail_ "bubblewrap (bwrap) is not installed"
      elif bwrap --unshare-all --share-net --ro-bind / / --dev /dev --proc /proc true 2>/dev/null; then
        ok_ "sandbox: bwrap $(bwrap --version 2>/dev/null | awk '{print $2}') can create namespaces"
        if bwrap --unshare-all --ro-bind / / --dev /dev --proc /proc true 2>/dev/null; then ok_ "sandbox: private network namespaces work (needed by ORCHESTRA_EGRESS_ALLOW)"
        else warn_ "sandbox: cannot create a private network namespace: ORCHESTRA_EGRESS_ALLOW will fail"; fi
      else fail_ "sandbox: bwrap cannot create namespaces (unprivileged user namespaces disabled? see docs/security.md)"; fi ;;
    none) if [ "${ORCHESTRA_ALLOW_UNSANDBOXED:-}" = 1 ]; then warn_ "ORCHESTRA_SANDBOX=none: workers run UNSANDBOXED"
          else fail_ "ORCHESTRA_SANDBOX=none without ORCHESTRA_ALLOW_UNSANDBOXED=1"; fi ;;
    *) fail_ "unknown ORCHESTRA_SANDBOX '$ORCHESTRA_SANDBOX'" ;;
  esac
  # Egress allowlist
  if [ -n "$ORCHESTRA_EGRESS_ALLOW" ]; then
    if python3 -I "$here/lib/egress_proxy.py" --check --allow "$ORCHESTRA_EGRESS_ALLOW" 2>/dev/null; then ok_ "egress allowlist: $ORCHESTRA_EGRESS_ALLOW"
    else fail_ "egress allowlist is malformed: $(python3 -I "$here/lib/egress_proxy.py" --check --allow "$ORCHESTRA_EGRESS_ALLOW" 2>&1)"; fi
    [ "$ORCHESTRA_SANDBOX" = bwrap ] || fail_ "ORCHESTRA_EGRESS_ALLOW needs ORCHESTRA_SANDBOX=bwrap"
  else echo "info  egress: the sandbox shares the host network (set ORCHESTRA_EGRESS_ALLOW to confine it)"; fi
  # Key: fetched, measured, never shown
  if [ -z "$ORCHESTRA_KEY_ENV" ]; then echo "info  no API key configured (ORCHESTRA_KEY_ENV empty: fine for local models)"
  else
    local k="" how
    if [ -n "$ORCHESTRA_KEY_CMD" ]; then how="ORCHESTRA_KEY_CMD"; k=$(bash -c "$ORCHESTRA_KEY_CMD" 2>/dev/null </dev/null) || k=""
    else how="\$$ORCHESTRA_KEY_ENV"; k=${!ORCHESTRA_KEY_ENV:-}; fi
    if [ -n "$k" ]; then ok_ "key from $how: ${#k} characters, fingerprint $(printf '%s' "$k" | sha256sum | cut -c1-8)"
    else fail_ "no key from $how (empty or the command failed)"; fi
    unset k
  fi
  # Repository: base, gate, dev environment, caches, budget
  if git -C "$repo" rev-parse --verify -q "$ORCHESTRA_BASE^{commit}" >/dev/null; then ok_ "base $ORCHESTRA_BASE ($(git -C "$repo" rev-parse --short "$ORCHESTRA_BASE"))"
  else fail_ "base $ORCHESTRA_BASE does not resolve (fetch, or set ORCHESTRA_BASE)"; fi
  if base_is_local "$repo"; then
    ok_ "base $ORCHESTRA_BASE is a local branch: land moves it in place (no fetch, no push, no --pr)"
  elif [[ $ORCHESTRA_BASE != */* ]] || ! git -C "$repo" remote | grep -qxF "${ORCHESTRA_BASE%%/*}"; then
    warn_ "base $ORCHESTRA_BASE is neither <remote>/<branch> of a configured remote nor a local branch: land cannot use it"; fi
  if [ -n "$ORCHESTRA_GATE" ]; then ok_ "gate: $ORCHESTRA_GATE"
  else warn_ "no ORCHESTRA_GATE: prove and land run only the spec's proof: lines"; fi
  if [ -n "$ORCHESTRA_DEVENV_CMD" ]; then
    local t0=$SECONDS
    if (cd "$repo" && timeout 300 bash -c "$ORCHESTRA_DEVENV_CMD") >/dev/null 2>&1; then ok_ "dev environment command works ($((SECONDS - t0))s)"
    else fail_ "ORCHESTRA_DEVENV_CMD failed: $ORCHESTRA_DEVENV_CMD"; fi
  fi
  local pair src
  for pair in $ORCHESTRA_RW_BINDS $ORCHESTRA_RO_BINDS; do src=${pair%%:*}; src=${src/#\~/$HOME}
    [ -d "$src" ] || warn_ "bind source $src does not exist yet (it will be created)"; done
  if [ -n "${ORCHESTRA_MAX_COST:-}" ]; then
    if [[ $ORCHESTRA_MAX_COST =~ ^[0-9]+(\.[0-9]+)?$ ]]; then ok_ "budget: at most \$$ORCHESTRA_MAX_COST per run"
    else fail_ "ORCHESTRA_MAX_COST must be a number of dollars (got '$ORCHESTRA_MAX_COST')"; fi
  else echo "info  no ORCHESTRA_MAX_COST: runs are limited by ORCHESTRA_TIMEOUT ($ORCHESTRA_TIMEOUT) only"; fi
  if [ "$ORCHESTRA_JEV" = off ]; then echo "info  jev: off (ORCHESTRA_JEV=shadow|advise turns on the second opinion; docs/jev.md)"
  else
    local jev_problem=""
    [ -n "$ORCHESTRA_JEV_KEY_CMD" ] || jev_problem="ORCHESTRA_JEV_KEY_CMD is not set"
    local jev_url=${ORCHESTRA_JEV_URL:-https://api.cloudflare.com/client/v4/accounts/\{account\}/ai/run}
    case $jev_url in *'{account}'*) [ -n "$ORCHESTRA_JEV_ACCOUNT_ID" ] || jev_problem="ORCHESTRA_JEV_ACCOUNT_ID is not set" ;; esac
    if [ -n "$jev_problem" ]; then warn_ "jev: $ORCHESTRA_JEV but $jev_problem (decisions will be logged as unavailable)"
    else ok_ "jev: $ORCHESTRA_JEV, model $ORCHESTRA_JEV_MODEL, key from ORCHESTRA_JEV_KEY_CMD (not run here)"; fi
  fi
  local base_dir; base_dir="$(dirname "$repo")/$(basename "$repo")-worktrees"
  local stale; stale=$(cmd_status "$here" --json 2>/dev/null | python3 -I -c 'import json,sys; print(sum(1 for r in json.load(sys.stdin)["runs"] if r["state"] == "stale"))' 2>/dev/null || echo 0)
  [ "${stale:-0}" = 0 ] || warn_ "$stale stale run state file(s): orchestra-worker status --prune"
  [ -d "$base_dir" ] && echo "info  worktrees: $base_dir"
  echo "--- $nfail failed, $nwarn warning(s)"
  [ "$nfail" = 0 ]
}

# cmd_guide [<name>] [--print]: the absolute path of a guide (or its text), so skills never guess relative paths.
cmd_guide() {
  local here=$1; shift; local name="" print=0
  while [ $# -gt 0 ]; do case "$1" in --print) print=1; shift ;; -*) die "unknown option $1" ;; *) name=$1; shift ;; esac; done
  local f
  case "${name:-orchestrator}" in
    orchestrator|orchestra) f=orchestrator-guide.md ;;
    planning|plan|refine) f=planning-guide.md ;;
    ops) f=ops-guide.md ;;
    security) f=security.md ;;
    proofs) f=proofs.md ;;
    design) f=design.md ;;
    harness) f=adding-a-harness.md ;;
    router) f=router.md ;;
    jev|decide) f=jev.md ;;
    templates) echo "$here/templates"; return 0 ;;
    *) die "unknown guide '$name' (orchestrator, planning, ops, security, proofs, design, harness, router, jev, templates)" ;;
  esac
  if [ "$print" = 1 ]; then cat "$here/docs/$f"; else echo "$here/docs/$f"; fi
}

# cmd_artifact: collect one task's report, diff and proofs as an artifact (lib/artifact.py, installed separately).
# Works on a task worktree, or on a scout's state directory when the task never ran.
cmd_artifact() {
  local here=$1; shift
  local task="" wt="" out="" local_flag=0 open=0 json_flag=0
  while [ $# -gt 0 ]; do case "$1" in
    --local) local_flag=1; shift ;;
    --open) open=1; shift ;;
    --json) json_flag=1; shift ;;
    --worktree) wt=${2:?}; shift 2 ;;
    --out|--out-dir) out=${2:?}; shift 2 ;;
    -*) die "unknown option $1" ;;
    *) [ -z "$task" ] || die "one task id only"; task=$1; shift ;;
  esac; done
  [ -n "$task" ] || die "usage: orchestra-worker artifact <task-id> [--local] [--open] [--json] [--worktree <dir>] [--out-dir <dir>]"
  [[ $task =~ ^[A-Za-z0-9._-]+$ ]] || die "task id may contain letters, digits, . _ - only"
  [ -f "$here/lib/artifact.py" ] || die "lib/artifact.py not installed"
  local repo; repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside a git repository"
  ORCHESTRA_NEEDS_MODEL=0 load_config "$repo"
  local wt_base; wt_base="$(dirname "$repo")/$(basename "$repo")-worktrees"
  [ -n "$wt" ] || wt="$wt_base/$task"
  wt=$(realpath -m "$wt")
  local scout_dir; scout_dir=$(realpath -m "$wt_base/.scout/$task")
  [ -d "$wt" ] || [ -d "$scout_dir" ] || die "no worktree or scout state for $task"
  local -a args=(--repo "$repo" --task "$task" --base "$ORCHESTRA_BASE")
  [ ! -d "$wt" ] || args+=(--worktree "$wt")
  [ ! -d "$scout_dir" ] || args+=(--scout-dir "$scout_dir")
  [ -z "$out" ] || args+=(--out-dir "$out")
  [ "$local_flag" = 0 ] || args+=(--local)
  [ "$open" = 0 ] || args+=(--open)
  [ "$json_flag" = 0 ] || args+=(--json)
  local rtmp=""
  if [ -d "$wt" ] && [ -n "$ORCHESTRA_RENDER_CMD" ]; then
    rtmp=$(mktemp)
    # shellcheck disable=SC2064  # expanded now on purpose: rtmp is out of scope when the trap runs
    trap "rm -f $(printf '%q' "$rtmp")" EXIT
    cmd_diff "$here" "$task" --worktree "$wt" --rendered > "$rtmp" 2>/dev/null || true
    [ -s "$rtmp" ] && args+=(--rendered-diff-file "$rtmp")
  fi
  # artifact.py reads these from the environment for its server upload, when configured.
  ORCHESTRA_ARTIFACTS_DIR=$ORCHESTRA_ARTIFACTS_DIR \
  ORCHESTRA_ARTIFACT_SERVER_ORIGIN=$ORCHESTRA_ARTIFACT_SERVER_ORIGIN \
  ORCHESTRA_ARTIFACT_TOKEN_CMD=$ORCHESTRA_ARTIFACT_TOKEN_CMD \
  python3 -I "$here/lib/artifact.py" "${args[@]}"
}

# cmd_clean: remove the worktrees of tasks that have landed (lib/clean.py decides which; it only lists without --yes).
cmd_clean() {
  local here=$1; shift
  local repo; repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside a git repository"
  ORCHESTRA_NEEDS_MODEL=0 load_config "$repo"
  python3 -I "$here/lib/clean.py" --repo "$repo" --worktrees "$(dirname "$repo")/$(basename "$repo")-worktrees" \
    --base "$ORCHESTRA_BASE" --ledger "$(ledger_file "$repo")" "$@"
}

# cmd_scout: a read-only worker reads a draft spec against the code and reports where things really live, what else
# must change, which tests assert the behaviour, and whether the acceptance commands exist. It cannot change the
# repository: the checkout and the git directory are mounted read-only, and its only writable place is its own home.
# Output: <repo>-worktrees/.scout/<task>/scout.json (shape in prompts/scout.md), and a short view of it.
cmd_scout() {
  local here=$1; shift; local task="" spec="" prompt_spec="" want_state=0
  while [ $# -gt 0 ]; do case "$1" in
    --spec) spec=${2:?}; shift 2 ;;
    --prompt) prompt_spec=${2:?}; shift 2 ;;
    --state) want_state=1; shift ;;
    -*) die "unknown option $1" ;;
    *) task=$1; shift ;;
  esac; done
  [ -n "$task" ] && { [ -n "$spec" ] || [ -n "$prompt_spec" ]; } || die "usage: orchestra-worker scout <task-id> (--spec <file> | --prompt <text>) [--state]"
  [ -z "$spec" ] || [ -z "$prompt_spec" ] || die "--spec and --prompt are mutually exclusive"
  [[ $task =~ ^[A-Za-z0-9._-]+$ ]] || die "task id may contain letters, digits, . _ - only"
  [ -z "$spec" ] || [ -f "$spec" ] || die "spec not found: $spec"
  local repo; repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside a git repository"
  load_config "$repo"
  local harness_file="$here/lib/harness/$ORCHESTRA_HARNESS.sh"
  case "$ORCHESTRA_HARNESS" in */*) harness_file=$(realpath -m "$ORCHESTRA_HARNESS") ;; esac
  [ -f "$harness_file" ] || die "unknown harness '$ORCHESTRA_HARNESS' (lib/harness/*.sh, or a path to a .sh file)"
  # shellcheck disable=SC1090
  . "$harness_file"
  if [ -n "$ORCHESTRA_ROUTER_EXT" ]; then
    [ -f "$ORCHESTRA_ROUTER_EXT" ] || die "ORCHESTRA_ROUTER_EXT not found: $ORCHESTRA_ROUTER_EXT"
    ORCHESTRA_ROUTER_EXT=$(realpath "$ORCHESTRA_ROUTER_EXT")
  else
    model_allowed "$ORCHESTRA_MODEL" || die "ORCHESTRA_MODEL $ORCHESTRA_MODEL is not in ORCHESTRA_ALLOWED_MODELS"
  fi

  local state; state="$(dirname "$repo")/$(basename "$repo")-worktrees/.scout/$task"
  mkdir -p "$state/sessions" "$state/runs" "$state/home"
  if [ -n "$prompt_spec" ]; then
    printf '%s\n' "$prompt_spec" > "$state/home/spec.md"
  else
    cp "$spec" "$state/home/spec.md"
  fi
  rm -f "$state/home/scout.json" "$state/home/state.md" "$state/home/live-state.txt" "$state/home/live-state.err" \
        "$state/scout.json" "$state/state.md"
  # A host-side, read-only snapshot of live state: no credentials enter the scout's sandbox.
  if [ -n "$ORCHESTRA_STATE_CMD" ]; then
    local state_rc=0
    set +e
    (cd "$repo" && bash -c "$ORCHESTRA_STATE_CMD") 2>"$state/home/live-state.err" \
      | head -c 65536 > "$state/home/live-state.txt"
    state_rc=${PIPESTATUS[0]}
    set -e
    if [ "$state_rc" != 0 ]; then
      log "warning: ORCHESTRA_STATE_CMD exited $state_rc: live state may be incomplete"
      printf '\n[orchestra: ORCHESTRA_STATE_CMD exited %s: live state may be incomplete]\n' "$state_rc" \
        >> "$state/home/live-state.txt"
    fi
  fi
  [ -s "$state/home/live-state.txt" ] && want_state=1
  local live_state="none" state_out=""
  if [ "$want_state" = 1 ]; then
    [ -s "$state/home/live-state.txt" ] && live_state="/home/worker/live-state.txt"
    state_out="/home/worker/state.md"
  fi
  local common; common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
  local devenv=""
  if [ -n "$ORCHESTRA_DEVENV_CMD" ]; then
    devenv="$state/devenv.sh"
    (cd "$repo" && bash -c "$ORCHESTRA_DEVENV_CMD") > "$devenv" 2>/dev/null || die "ORCHESTRA_DEVENV_CMD failed"
  fi
  local prompt; prompt=$(TASK="$task" SPEC="/home/worker/spec.md" OUT="/home/worker/scout.json" REPO="$repo" \
    LIVE_STATE="$live_state" STATE_OUT="$state_out" python3 -I -c '
import os,sys
t=open(sys.argv[1]).read()
for k in ("TASK","SPEC","OUT","REPO","LIVE_STATE","STATE_OUT"): t=t.replace("{{"+k+"}}", os.environ[k])
print(t)' "$here/prompts/scout.md")
  shopt -s nullglob; local runs=("$state"/runs/run-*.jsonl); shopt -u nullglob
  local n=$(( ${#runs[@]} + 1 )) out="$state/runs/run-$(( ${#runs[@]} + 1 ))"
  local -a hargv; harness_argv hargv "scout-$task" "$state" "$prompt"
  egress_plan "${ORCHESTRA_DRY_RUN:-0}"
  local -a sandbox; SCOUT=1 build_sandbox sandbox "$repo" "$common" "$common" "$state" "$devenv"
  if [ "${ORCHESTRA_DRY_RUN:-}" = 1 ]; then printf '%q ' "${sandbox[@]}" "${hargv[@]:0:${#hargv[@]}-1}" "<prompt>"; echo; return 0; fi
  local key=""
  if [ -n "$ORCHESTRA_KEY_ENV" ]; then
    if [ -n "$ORCHESTRA_KEY_CMD" ]; then key=$(bash -c "$ORCHESTRA_KEY_CMD") || die "ORCHESTRA_KEY_CMD failed"
    else key=${!ORCHESTRA_KEY_ENV:-}; fi
    [ -n "$key" ] || die "no API key: set ORCHESTRA_KEY_CMD or export $ORCHESTRA_KEY_ENV"
  fi
  log "scout $task: read-only, model $ORCHESTRA_MODEL, timeout ${ORCHESTRA_SCOUT_TIMEOUT:-15m}"
  local progress; progress=$(progress_script "$harness_file")
  check_budget_setup "$progress"
  guard_running "$state" "scout $task"
  write_run_state "$state" "$task" "$n" "$repo" "$ORCHESTRA_MODEL" "$ORCHESTRA_HARNESS" "$out.jsonl" "$progress" scout
  # shellcheck disable=SC2064  # expanded now on purpose: $state is out of scope when the trap runs
  trap "rm -f $(printf '%q' "$state/run.json"); egress_stop" EXIT
  egress_start "$out.egress.log"
  local rc=0
  launch_worker "scout:$task" "$out" "$progress" "${ORCHESTRA_SCOUT_TIMEOUT:-15m}"; rc=$LAUNCH_RC
  unset key
  egress_stop
  [ "$rc" != 5 ] || { log "scout stopped: over budget (ORCHESTRA_MAX_COST)"; return 5; }
  local used m bad=""; used=$(harness_models_used "$out.jsonl")
  for m in $used; do model_allowed "$m" || bad="$bad $m"; done
  harness_usage "$out.jsonl" > "$out.usage.json" || echo '{}' > "$out.usage.json"
  [ -z "$bad" ] || { log "MODEL POLICY: model(s) not allowed answered:$bad"; return 3; }
  [ -s "$state/home/scout.json" ] || { log "scout wrote no scout.json (exit $rc; see $out.err)"; return 4; }
  cp "$state/home/scout.json" "$state/scout.json"
  if [ -s "$state/home/state.md" ]; then
    cp "$state/home/state.md" "$state/state.md"
    echo "state snapshot: $state/state.md"
  fi
  python3 -I "$here/lib/scout_view.py" "$state/scout.json" "$task" "$out.usage.json" || return 4
  echo "full scout report: $state/scout.json"
  return "$rc"
}

# ---- review and landing: diff, prove, land (no model involved) ----------------------------------------------------

# task_setup <task> <wt-or-empty>: sets repo, wt, state for a command that works on an existing task worktree.
task_setup() {
  local task=$1; wt=$2
  [[ $task =~ ^[A-Za-z0-9._-]+$ ]] || die "task id may contain letters, digits, . _ - only"
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "run inside a git repository"
  ORCHESTRA_NEEDS_MODEL=0 load_config "$repo"
  [ -n "$wt" ] || wt="$(dirname "$repo")/$(basename "$repo")-worktrees/$task"
  wt=$(realpath -m "$wt"); [ -d "$wt" ] || die "no worktree for $task at $wt"
  state="$wt/.orchestra"; mkdir -p "$state/proofs"
  local common; common=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)
  grep -qxF '.orchestra/*' "$common/info/exclude" 2>/dev/null || printf '%s\n' '.orchestra/*' '!.orchestra/config.env' >> "$common/info/exclude"
}

# work_tree <wt>: the git tree hash of everything in the worktree (tracked and untracked, not ignored), without
# touching the real index. Any change to the code changes it, which is what makes a proof stale.
work_tree() {
  local wt=$1 idx; idx=$(mktemp)
  cp "$(git -C "$wt" rev-parse --path-format=absolute --git-path index)" "$idx" 2>/dev/null || true
  GIT_INDEX_FILE=$idx git -C "$wt" add -A >/dev/null 2>&1
  GIT_INDEX_FILE=$idx git -C "$wt" write-tree; rm -f "$idx"
}

# spec_file <wt> <task>: the task's spec in the worktree, or the copy a run made.
spec_file() {
  local f; for f in "$1/$ORCHESTRA_TASKS_DIR/$2"-*.md "$1/.orchestra/spec.md"; do [ -f "$f" ] && { echo "$f"; return 0; }; done
  return 0   # no spec is fine (the gate still runs); never trip set -e in the caller's assignment
}

# write_candidate <wt> <task> <tree>: record the exact state a prove passed on in .orchestra/candidate.json, so
# review and land can show what changed since. Written atomically (a temp file beside it, then mv), and a base that
# does not resolve is recorded as null rather than failing the write. The file lives under .orchestra/, which is
# excluded from the tree hash, so writing it does not invalidate the proof it records.
write_candidate() {
  local wt=$1 task=$2 tree=$3 state; state="$wt/.orchestra"
  local spec base=${ORCHESTRA_BASE:-} base_commit="" spec_tree=""
  spec=$(spec_file "$wt" "$task")
  if [ -n "$base" ]; then base_commit=$(git -C "$wt" rev-parse -q --verify "$base^{commit}" 2>/dev/null || true); fi
  if [ -n "$spec" ]; then spec_tree=$(git -C "$wt" hash-object "$spec" 2>/dev/null || true); fi
  shopt -s nullglob; local -a runs=("$state"/runs/run-*.jsonl); shopt -u nullglob
  local n=""; [ ${#runs[@]} -gt 0 ] && n=${#runs[@]}
  python3 -I - "$state/candidate.json" "$task" "$n" "$base" "$base_commit" "$tree" "$spec" "$spec_tree" <<'PYCAND'
import json, os, sys, tempfile, time
path, task, run, base, base_commit, tree, spec, spec_tree = sys.argv[1:]

def or_none(value):
    return value if value != "" else None

try:
    run = int(run)
except ValueError:
    run = None
record = {"task": task, "run": run, "base": base, "base_commit": or_none(base_commit), "tree": tree,
          "spec": or_none(spec), "spec_tree": or_none(spec_tree),
          "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".candidate.", suffix=".tmp")
with os.fdopen(fd, "w") as f:
    json.dump(record, f, indent=1); f.write("\n")
os.replace(tmp, path)
PYCAND
}

# candidate_tree <wt> <task>: the tree hash of the last successful prove, or empty when the record is missing,
# unreadable, or for another task.
candidate_tree() {
  python3 -I - "$1/.orchestra/candidate.json" "$2" <<'PYCT'
import json, sys
try:
    record = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    record = None
if isinstance(record, dict) and record.get("task") == sys.argv[2] and isinstance(record.get("tree"), str):
    print(record["tree"])
PYCT
}

# candidate_drift_notice <wt> <task>: say so when the tree about to be published differs from the last candidate,
# and show the stat. It never stops the landing: land re-proves the tree it publishes.
candidate_drift_notice() {
  local wt=$1 task=$2 cand live
  cand=$(candidate_tree "$wt" "$task")
  [ -n "$cand" ] || return 0
  live=$(work_tree "$wt")
  [ "$cand" != "$live" ] || return 0
  echo "candidate drift: publishing a tree that differs from the candidate"
  git -C "$wt" --no-pager diff --stat=100 "$cand" "$live" 2>/dev/null | sed 's/^/  /' || true
}

# checks <wt> <task>: the gate, then every `proof:` line of the spec (- proof: `command`), one per line.
checks() {
  {
    [ -n "$ORCHESTRA_GATE" ] && printf '%s\n' "$ORCHESTRA_GATE"
    local spec; spec=$(spec_file "$1" "$2")
    [ -n "$spec" ] && grep -oE 'proof:[[:space:]]*`[^`]+`' "$spec" | sed -E 's/^proof:[[:space:]]*`(.*)`$/\1/'
  } | awk '!seen[$0]++'   # a spec proof that repeats the gate runs once
  return 0
}

cmd_diff() {
  local here=$1; shift; local task="" wt="" stat=0 rendered=0
  while [ $# -gt 0 ]; do case "$1" in
    --worktree) wt=${2:?}; shift 2 ;;
    --stat) stat=1; shift ;;
    --rendered) rendered=1; shift ;;
    -*) die "unknown option $1" ;;
    *) task=$1; shift ;;
  esac; done
  [ -n "$task" ] || die "usage: orchestra-worker diff <task-id> [--worktree <dir>] [--stat] [--rendered]"
  local repo state; task_setup "$task" "$wt"
  if [ "$rendered" = 1 ]; then
    [ -n "$ORCHESTRA_RENDER_CMD" ] || die "--rendered needs ORCHESTRA_RENDER_CMD (a command that prints the rendered form)"
    local tmp; tmp=$(mktemp -d)
    local base_wt="$tmp/base"
    # shellcheck disable=SC2064  # expanded now on purpose: $tmp is out of scope when the trap runs
    trap "git -C $(printf '%q' "$wt") worktree remove --force $(printf '%q' "$base_wt") >/dev/null 2>&1 || true; rm -rf $(printf '%q' "$tmp")" EXIT
    git -C "$wt" worktree add -q --detach "$base_wt" "$ORCHESTRA_BASE" \
      || die "could not create a worktree at $ORCHESTRA_BASE"
    (cd "$base_wt" && bash -c "$ORCHESTRA_RENDER_CMD") > "$tmp/base.out" 2>"$tmp/base.err" \
      || die "ORCHESTRA_RENDER_CMD failed at $ORCHESTRA_BASE (see $tmp/base.err)"
    (cd "$wt" && bash -c "$ORCHESTRA_RENDER_CMD") > "$tmp/worktree.out" 2>"$tmp/worktree.err" \
      || die "ORCHESTRA_RENDER_CMD failed in $wt (see $tmp/worktree.err)"
    diff -u "$tmp/base.out" "$tmp/worktree.out" || true
    return 0
  fi
  local mb; mb=$(git -C "$wt" merge-base HEAD "$ORCHESTRA_BASE" 2>/dev/null) || die "no merge base with $ORCHESTRA_BASE (fetch first?)"
  local idx; idx=$(mktemp); cp "$(git -C "$wt" rev-parse --path-format=absolute --git-path index)" "$idx"
  GIT_INDEX_FILE=$idx git -C "$wt" add -A >/dev/null 2>&1
  local -a ex=(); local g; for g in $ORCHESTRA_GENERATED; do ex+=(":(exclude,glob)**/$g"); done
  GIT_INDEX_FILE=$idx git -C "$wt" --no-pager diff --cached --stat=120 "$mb" -- . ':(exclude).orchestra'
  if [ "$stat" = 0 ]; then
    echo "(generated files are in the stat above, not below: ORCHESTRA_GENERATED)"
    GIT_INDEX_FILE=$idx git -C "$wt" --no-pager diff --cached "$mb" -- . ':(exclude).orchestra' "${ex[@]}"
  fi
  rm -f "$idx"
}

# prove_all <wt> <task>: run every check not yet proven on the current code; one line each. Returns 1 on a failure.
prove_all() {
  local wt=$1 task=$2 tree; tree=$(work_tree "$wt")
  local devenv="$wt/.orchestra/devenv.sh" ok=0 n=0 line
  if [ -n "$ORCHESTRA_DEVENV_CMD" ] && { [ ! -s "$devenv" ] || [ "$(find "$devenv" -mmin +1440 2>/dev/null)" ]; }; then
    (cd "$wt" && bash -c "$ORCHESTRA_DEVENV_CMD") > "$devenv" 2>/dev/null || die "ORCHESTRA_DEVENV_CMD failed"
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue; n=$((n+1))
    if python3 -I - "$wt/.orchestra/proofs.jsonl" "$tree" "$line" <<'PY'
import json, sys
f, tree, check = sys.argv[1:]
try: rows = [json.loads(l) for l in open(f)]
except OSError: rows = []
sys.exit(0 if any(r.get("tree") == tree and r.get("check") == check and r.get("exit") == 0 for r in rows) else 1)
PY
    then echo "PASS  (proven)  $line"; continue; fi
    local log t0=$SECONDS rc=0; log="$wt/.orchestra/proofs/$(date +%s)-$n.log"
    if [ -s "$devenv" ]; then (cd "$wt" && bash -c '. "$1" >/dev/null 2>&1; shift; eval "$1"' _ "$devenv" "$line") > "$log" 2>&1 </dev/null || rc=$?
    else (cd "$wt" && bash -c "$line") > "$log" 2>&1 </dev/null || rc=$?; fi
    local secs=$((SECONDS-t0))
    python3 -I -c 'import json,sys,time; print(json.dumps({"check":sys.argv[1],"exit":int(sys.argv[2]),"secs":int(sys.argv[3]),"tree":sys.argv[4],"at":time.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime()),"log":sys.argv[5]}))' \
      "$line" "$rc" "$secs" "$tree" "$log" >> "$wt/.orchestra/proofs.jsonl"
    if [ "$rc" = 0 ]; then echo "PASS  (${secs}s)  $line"
    else ok=1; echo "FAIL  (${secs}s, exit $rc)  $line"; tail -n 15 "$log" | sed 's/^/      /'; echo "      full log: $log"; fi
  done < <(checks "$wt" "$task")
  [ "$n" -gt 0 ] || { echo "no checks: set ORCHESTRA_GATE or add \`proof:\` lines to the spec"; return 1; }
  if [ "$ok" = 0 ]; then write_candidate "$wt" "$task" "$tree"; fi
  echo "tree ${tree:0:12}"
  return $ok
}

cmd_prove() {
  local here=$1; shift; local task="" wt="" manual=""
  while [ $# -gt 0 ]; do case "$1" in --worktree) wt=${2:?}; shift 2 ;; --manual) manual=${2:?}; shift 2 ;; -*) die "unknown option $1" ;; *) task=$1; shift ;; esac; done
  [ -n "$task" ] || die "usage: orchestra-worker prove <task-id> [--worktree <dir>] [--manual \"what you checked\"]"
  local repo state; task_setup "$task" "$wt"
  if [ -n "$manual" ]; then
    local tree; tree=$(work_tree "$wt")
    python3 -I -c 'import json,sys,time; print(json.dumps({"manual":sys.argv[1],"tree":sys.argv[2],"at":time.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime())}))' \
      "$manual" "$tree" >> "$state/proofs.jsonl"
    write_candidate "$wt" "$task" "$tree"
    echo "recorded manual proof: $manual"; return 0
  fi
  prove_all "$wt" "$task"
}

# base_is_local <repo>: true when ORCHESTRA_BASE names a local branch rather than <remote>/<branch> of a configured
# remote (an integration branch, or a forge that is not reachable). "plan/x" is local when "plan" is not a remote.
base_is_local() {
  local repo=$1
  if [[ $ORCHESTRA_BASE == */* ]] && git -C "$repo" remote | grep -qxF "${ORCHESTRA_BASE%%/*}"; then return 1; fi
  git -C "$repo" show-ref --verify -q "refs/heads/$ORCHESTRA_BASE"
}

# land_local <wt> <task> <base-branch> <old-commit>: move a local base to the proven commit, only if it still points
# at <old-commit> (the commit the task was rebased onto). Returns 1 when the base moved, so land rebases and proves
# again. A checkout of the base is fast-forwarded only when it has no uncommitted changes to tracked files: moving the
# ref under a dirty checkout would make its work look reverted.
land_local() {
  local wt=$1 task=$2 base=$3 old=$4 new co
  new=$(git -C "$wt" rev-parse HEAD)
  co=$(git -C "$wt" worktree list --porcelain | awk -v want="branch refs/heads/$base" '/^worktree /{w=substr($0, 10)} $0 == want {print w}')
  if [ -n "$co" ]; then
    [ -z "$(git -C "$co" status --porcelain --untracked-files=no)" ] \
      || die "not landed: $base is checked out with uncommitted changes in $co (commit or stash them, then land again)"
    [ "$(git -C "$co" rev-parse HEAD)" = "$old" ] || return 1
    git -C "$co" merge -q --ff-only "$new" || return 1
  else
    git -C "$wt" update-ref -m "orchestra land $task" "refs/heads/$base" "$new" "$old" 2>/dev/null || return 1
  fi
  echo "landed $task on local $base: $(git -C "$wt" log -1 --format='%h %s')"
}

# land_pr <wt> <task> <base-branch>: for protected bases. Push the proven, squashed commit to its own branch
# (ORCHESTRA_PR_BRANCH, default orchestra/<task>; force-with-lease, it is the task's own branch, never the base) and
# open a pull request with ORCHESTRA_PR_CMD ({branch} {base} {title} {body} replaced; default: gh when installed).
land_pr() {
  local wt=$1 task=$2 base=$3
  local prb=${ORCHESTRA_PR_BRANCH:-"orchestra/{task}"}; prb=${prb//\{task\}/$task}
  [ "$prb" != "$base" ] || die "ORCHESTRA_PR_BRANCH must not be the base branch"
  local push=${ORCHESTRA_PR_PUSH_CMD:-}
  if [ -z "$push" ]; then
    # Forgejo-first: push to the remote the base names (forgejo/main -> forgejo), or origin.
    local remote=origin
    if [[ $ORCHESTRA_BASE == */* ]]; then
      local candidate=${ORCHESTRA_BASE%%/*}
      git -C "$wt" remote | grep -qxF "$candidate" && remote=$candidate
    fi
    push="git push --force-with-lease $remote HEAD:refs/heads/{branch}"
  fi
  (cd "$wt" && bash -c "${push//\{branch\}/$prb}") >/dev/null 2>&1 || die "could not push $prb (ORCHESTRA_PR_PUSH_CMD)"
  local title body; title=$(git -C "$wt" log -1 --format=%s); body=$(mktemp)
  git -C "$wt" log -1 --format=%b > "$body"
  local cmd=${ORCHESTRA_PR_CMD:-}
  if [ -z "$cmd" ] && command -v gh >/dev/null; then cmd='gh pr create --base "{base}" --head "{branch}" --title "{title}" --body-file "{body}"'; fi
  if [ -z "$cmd" ] || [ "$cmd" = none ]; then
    rm -f "$body"
    echo "proven and pushed to $prb: open a pull request into $base (set ORCHESTRA_PR_CMD to do it automatically)"; return 0
  fi
  # Placeholders become variable references, expanded by the shell that runs the command: the title comes from a
  # commit message, and an expanded value is never parsed again, so "$(...)" in a title cannot run anything.
  # Quote the placeholders in the template ("{title}") to keep spaces together.
  cmd=${cmd//\{branch\}/\$\{ORCHESTRA_PR_HEAD\}}; cmd=${cmd//\{base\}/\$\{ORCHESTRA_PR_BASE\}}
  cmd=${cmd//\{title\}/\$\{ORCHESTRA_PR_TITLE\}}; cmd=${cmd//\{body\}/\$\{ORCHESTRA_PR_BODY\}}
  local out; if out=$(cd "$wt" && ORCHESTRA_PR_HEAD=$prb ORCHESTRA_PR_BASE=$base ORCHESTRA_PR_TITLE=$title \
                      ORCHESTRA_PR_BODY=$body bash -c "$cmd" 2>&1); then
    rm -f "$body"; echo "proven, pushed to $prb, pull request: $(printf '%s' "$out" | tail -1)"; return 0
  fi
  rm -f "$body"; die "pushed $prb, but opening the pull request failed: $(printf '%s' "$out" | tail -1)"
}

cmd_land() {
  local here=$1; shift; local task="" wt="" msgfile="" pr=0
  [ "${ORCHESTRA_LAND:-push}" = pr ] && pr=1
  while [ $# -gt 0 ]; do case "$1" in
    --worktree) wt=${2:?}; shift 2 ;; --message-file) msgfile=${2:?}; shift 2 ;;
    --pr) pr=1; shift ;; --push) pr=0; shift ;;
    -*) die "unknown option $1" ;; *) task=$1; shift ;;
  esac; done
  [ -n "$task" ] || die "usage: orchestra-worker land <task-id> [--pr] [--worktree <dir>] [--message-file <file>]"
  local repo state; task_setup "$task" "$wt"
  [ -z "$msgfile" ] || [ -f "$msgfile" ] || die "message file not found: $msgfile"
  local remote=${ORCHESTRA_BASE%%/*} branch=${ORCHESTRA_BASE#*/} localbase=0 onto
  if base_is_local "$wt"; then
    localbase=1; branch=$ORCHESTRA_BASE
    [ "$pr" = 0 ] || die "land --pr needs a remote base: $ORCHESTRA_BASE is a local branch"
  else
    [ "$remote" != "$ORCHESTRA_BASE" ] || die "ORCHESTRA_BASE must be <remote>/<branch> or a local branch"
  fi
  local title="" spec; spec=$(spec_file "$wt" "$task")
  [ -n "$spec" ] && title=$(sed -n 's/^title:[[:space:]]*//p' "$spec" | head -1)
  # Uncommitted work becomes one commit first; everything is squashed below.
  if [ -n "$(git -C "$wt" status --porcelain)" ]; then git -C "$wt" add -A && git -C "$wt" commit -qm "wip $task"; fi
  # Keep a message someone already wrote: the newest commit on the branch that is not a claim, wip or squash.
  local kept=""; if [ -z "$msgfile" ]; then
    local c; for c in $(git -C "$wt" rev-list "$ORCHESTRA_BASE..HEAD" 2>/dev/null); do
      case "$(git -C "$wt" log -1 --format=%s "$c")" in "claim "*|"wip "*|"squash "*) continue ;; esac
      kept=$(mktemp); git -C "$wt" log -1 --format=%B "$c" | grep -v '^Proof: ' > "$kept"; break
    done
  fi
  for _ in 1 2; do   # one retry if the base moved
    if [ "$localbase" = 0 ]; then git -C "$wt" fetch -q "$remote" || die "fetch failed"; fi
    onto=$(git -C "$wt" rev-parse "$ORCHESTRA_BASE^{commit}")
    git -C "$wt" rebase -q "$ORCHESTRA_BASE" >/dev/null 2>&1 || { git -C "$wt" rebase --abort 2>/dev/null; die "rebase onto $ORCHESTRA_BASE has conflicts: resolve them in $wt, then land again"; }
    # Squash onto the base we just rebased on (safe: nothing on the base is behind us, so nothing is reverted).
    if [ "$(git -C "$wt" rev-list --count "$ORCHESTRA_BASE..HEAD")" -gt 1 ] || [ "$(git -C "$wt" log -1 --format=%s)" = "wip $task" ]; then
      git -C "$wt" reset -q --soft "$ORCHESTRA_BASE"
      git -C "$wt" commit -qm "squash $task" --allow-empty
    fi
    [ "$(git -C "$wt" rev-list --count "$ORCHESTRA_BASE..HEAD")" = 1 ] || die "nothing to land for $task"
    echo "changes:"; git -C "$wt" --no-pager diff --stat=100 "$ORCHESTRA_BASE" HEAD | tail -n 12 | sed 's/^/  /'
    candidate_drift_notice "$wt" "$task"
    prove_all "$wt" "$task" || die "not landed: a check failed (the worktree is rebased and squashed; fix, then land again)"
    # Message: the given file, or "<task>: <title>"; then one Proof: trailer per check and manual proof.
    local msg; msg=$(mktemp)
    if [ -n "$msgfile" ]; then cat "$msgfile" > "$msg"
    elif [ -n "$kept" ]; then sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$kept" > "$msg"
    else printf '%s: %s\n' "$task" "${title:-$task}" > "$msg"; fi
    python3 -I - "$state/proofs.jsonl" "$(work_tree "$wt")" >> "$msg" <<'PY'
import json, sys
rows = [json.loads(l) for l in open(sys.argv[1])]
tree = sys.argv[2]
lines, seen = [], set()
for r in rows:
    if r.get("tree") == tree and r.get("exit") == 0 and r["check"] not in seen:
        seen.add(r["check"]); lines.append(f'Proof: pass ({r["secs"]}s) tree {tree[:12]}: {r["check"]}')
for r in rows:
    if "manual" in r and r["manual"] not in seen:
        seen.add(r["manual"]); lines.append(f'Proof: manual: {r["manual"]}')
print("\n" + "\n".join(lines))
PY
    git -C "$wt" commit -q --amend -F "$msg"; rm -f "$msg"
    if [ "$pr" = 1 ]; then land_pr "$wt" "$task" "$branch"; return; fi
    if [ "$localbase" = 1 ]; then
      land_local "$wt" "$task" "$branch" "$onto" && return 0
      echo "$ORCHESTRA_BASE moved while proving; rebasing and proving again"; continue
    fi
    if (cd "$wt" && bash -c "${ORCHESTRA_PUSH_CMD//\{branch\}/$branch}") >/dev/null 2>&1; then
      echo "landed $task: $(git -C "$wt" log -1 --format='%h %s')"; return 0
    fi
    echo "push rejected ($ORCHESTRA_BASE moved); rebasing and proving again"
  done
  die "push rejected twice; land again when $ORCHESTRA_BASE is quiet"
}

main "$@"
