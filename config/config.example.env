# orchestra configuration (shell syntax, KEY=value).
# Copy to ~/.config/orchestra/config.env for your defaults; a repository can override any key in
# <repo>/.orchestra/config.env; environment variables override both.

# ---- Worker model (any provider/model your harness supports) -------------------------------------------------
# The model workers run on. One cheap, fast model is the point: the orchestrator does the thinking.
ORCHESTRA_MODEL=deepseek/deepseek-flash
# Models allowed to answer. After every run the event log is checked; any other model fails the run (exit 3).
ORCHESTRA_ALLOWED_MODELS=deepseek/deepseek-flash
# Harness thinking/reasoning level (pi: off, minimal, low, medium, high, xhigh, max).
ORCHESTRA_THINKING=low

# Other examples (pick one pair):
#   ORCHESTRA_MODEL=openai/gpt-5-mini              ORCHESTRA_KEY_ENV=OPENAI_API_KEY
#   ORCHESTRA_MODEL=anthropic/claude-haiku-5-5     ORCHESTRA_KEY_ENV=ANTHROPIC_API_KEY
#   ORCHESTRA_MODEL=openrouter/qwen/qwen3-coder    ORCHESTRA_KEY_ENV=OPENROUTER_API_KEY
#   ORCHESTRA_MODEL=ollama/qwen3-coder:30b         (local, no key: leave ORCHESTRA_KEY_ENV empty)
# List what your harness knows: pi --list-models

# ---- API key ----------------------------------------------------------------------------------------------------
# The variable the harness reads the key from, and a command that prints the key. The key is fetched outside the
# sandbox and handed in on a file descriptor: never on a command line, never written to disk.
ORCHESTRA_KEY_ENV=DEEPSEEK_API_KEY
# Examples (use one; leave empty to read $ORCHESTRA_KEY_ENV from your environment):
#   ORCHESTRA_KEY_CMD='pass show api/deepseek-agents'
#   ORCHESTRA_KEY_CMD='op read op://Private/deepseek-agents/credential'
#   ORCHESTRA_KEY_CMD='bws secret get <secret-id> | jq -r .value'
#   ORCHESTRA_KEY_CMD='secret-tool lookup service deepseek-agents'
ORCHESTRA_KEY_CMD=
# Use a separate key for workers, with a spend limit, so a looping worker cannot drain your other budgets.

# ---- Harness, limits, sandbox ---------------------------------------------------------------------------------
ORCHESTRA_HARNESS=pi          # lib/harness/<name>.sh
ORCHESTRA_TIMEOUT=45m         # wall-clock cap per run (also your cost cap)
ORCHESTRA_SANDBOX=bwrap       # bwrap (Linux) | none (needs ORCHESTRA_ALLOW_UNSANDBOXED=1; see docs/security.md)

# Extra mounts, space-separated host:sandbox pairs; ~ on the left is your home, on the right the worker's home.
# Example: share Go and npm caches read-write so workers don't re-download modules.
#   ORCHESTRA_RW_BINDS='~/go/pkg/mod:~/go/pkg/mod ~/.cache/go-build:~/.cache/go-build ~/.npm:~/.npm'
ORCHESTRA_RW_BINDS=
ORCHESTRA_RO_BINDS=

# ---- Per-repository settings (usually in <repo>/.orchestra/config.env) -------------------------------------------
# Command that prints shell exports for the dev toolchain, sourced inside the sandbox. Examples:
#   ORCHESTRA_DEVENV_CMD='nix print-dev-env'
#   ORCHESTRA_DEVENV_CMD='mise env -s bash'
ORCHESTRA_DEVENV_CMD=
# Command that creates the task's worktree; {task} is replaced. Default: git worktree add -b orchestra/<task>.
#   ORCHESTRA_WORKTREE_CMD='scripts/task.sh claim {task}'
ORCHESTRA_WORKTREE_CMD=
# The checks a worker must run before reporting, in words the worker can follow.
#   ORCHESTRA_CHECKS='`make check` (it needs Postgres: start one with scripts/dev-db.sh)'
ORCHESTRA_CHECKS=
# Review and landing (orchestra-worker diff / prove / land; docs/proofs.md).
# The repository's landing gate, one shell command run in the worktree with the dev environment.
#   ORCHESTRA_GATE='make check'
ORCHESTRA_GATE=
# What tasks are reviewed against and land on (<remote>/<branch>), and how to push there ({branch} is replaced).
ORCHESTRA_BASE=origin/main
ORCHESTRA_PUSH_CMD='git push origin HEAD:refs/heads/{branch}'
# Where task specs live (for `proof:` lines and the default commit title).
ORCHESTRA_TASKS_DIR=docs/work/tasks
# Generated files: shown in the diff stat, left out of the diff body. Space-separated globs.
#   ORCHESTRA_GENERATED='*_templ.go *.pb.go go.sum package-lock.json'
